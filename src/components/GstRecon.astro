// A demo cursor clicks through the chips on its own (like the homepage product demo). A real click holds it for a while;
// keyboard focus pauses it, and it only runs on screen.
interface Props {
  return?: '2b' | '1';
}
const { return: ret = '2b' } = Astro.props;

