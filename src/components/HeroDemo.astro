---
// Glean-style demo stage (from the upstream hero): a looping background video behind a glass frame holding the product itself.
// Visitors can click the sidebar or the screen tabs; it auto-advances otherwise and pauses on hover.
// An app window (rebuilt from the real dashboard, demo data) cycles through its screens while a cursor clicks the sidebar.
import fs from 'node:fs';
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import heroBg from '../assets/img/hero-bg.png';

const poster = await getImage({ src: heroBg, width: 1600, format: 'webp', quality: 78 });
const hasVideo = fs.existsSync('public/hero/hero-loop.mp4');

const meta = [
  { tab: 'CFO cockpit', title: 'CFO cockpit', sub: 'Every finance operation in one view. Updated 06:00.' },
  { tab: 'Cash flow', title: 'Cash flow', sub: '776 invoices, payment status verified from the email trail' },
  { tab: 'Payments', title: 'Payments received', sub: '412 payments this month' },
  { tab: 'Bills', title: 'Bills', sub: '64 bills due this week, each checked before payment' },
  { tab: 'Vendors', title: 'Vendor reconciliation', sub: '579 vendors, books against bank' },
  { tab: 'GST', title: 'GST reconciliation', sub: 'India entity · GSTR-2B against Zoho Books' },
  { tab: 'Approvals', title: 'Approval board', sub: 'Payment requests across every site' },
];

const trail = [
  { inv: 'INV-2026-0412', next: 'Client must send 3 missing POs before they pay', client: 'Halden Logistics', amt: '£40,100', tag: ['Disputed', 'red'], act: 'no proof, 41d quiet', btn: ['Hold', 'green'] },
  { inv: 'INV-2026-0388', next: 'Ask for remittance: client says paid on 12 Sep', client: 'Kestrel Hospitality', amt: '£9,400', tag: ['Client says paid', 'purple'], act: '6 emails, not in bank', btn: ['Send', 'amber'] },
  { inv: 'INV-2026-0451', next: 'Chase second approver, out of office', client: 'Arden Property', amt: '£7,050', tag: ['Chase', 'amber'], act: '11 emails, 19d quiet', btn: ['Send', 'amber'] },
];

const ready = [
  { inv: 'INV-2026-0399', next: 'Overdue 12 days, no dispute. Send a reminder', client: 'Meridian Foods', amt: '£14,200', tag: ['Overdue', 'amber'], act: '3 emails, no reply', btn: ['Send', 'amber'] },
  { inv: 'INV-2026-0371', next: 'Paid in full, matched to bank line on 6 Oct', client: 'Brightwater Catering', amt: '£10,400', tag: ['Reconciled', 'green'], act: 'remittance matched', btn: ['Done', 'green'] },
];

const payments = [
  { date: '06 Oct', no: '3840', who: 'Brightwater Catering', amt: '£33,991.92', mode: 'Cash', flag: true },
  { date: '06 Oct', no: '3839', who: 'Kestrel Hospitality', amt: '£21,151.39', mode: 'Bank transfer', flag: false },
  { date: '05 Oct', no: '3838', who: 'Meridian Foods', amt: '£4,500.00', mode: 'Cash', flag: true },
  { date: '05 Oct', no: '3837', who: 'Arden Property Services', amt: '£7,050.00', mode: 'Bank transfer', flag: false },
  { date: '04 Oct', no: '3835', who: 'Halden Logistics', amt: '£18,240.00', mode: 'Bank transfer', flag: false },
];

// Bills due: the held ones reuse the site's demo story (Pinecrest already paid, Fenwick duplicate).
const bills = [
  { who: 'Pinecrest Maintenance', no: 'PM-1190', due: '28 Oct', amt: '£7,343.66', check: ['Already paid 12 Sep', 'red'], status: ['Held', 'red'] },
  { who: 'Fenwick Plant Hire', no: 'HIRE-3381', due: '30 Oct', amt: '£1,840.00', check: ['Duplicate', 'red'], status: ['Held', 'red'] },
  { who: 'Halden Logistics', no: 'HL-7720', due: '31 Oct', amt: '£12,480.00', check: ['PO matched', 'green'], status: ['2nd approver', 'blue'] },
  { who: 'Brightwater Catering', no: 'BC-2214', due: '1 Nov', amt: '£1,265.50', check: ['PO + approval', 'green'], status: ['Ready to pay', 'green'] },
  { who: 'Thornbury Electrical', no: 'TE-1187', due: '3 Nov', amt: '£3,960.00', check: ['Price differs from PO', 'amber'], status: ['Query sent', 'amber'] },
];

// GSTR-2B vs books: same demo rows and totals as the GST table on the India and product pages.
const gst = [
  { inv: '812', who: 'Nilgiri Foods Pvt Ltd', gstin: '33AB•••••1Z9', twoB: '₹1,19,271', books: '₹1,12,400', tag: ['Freight line missing', 'amber'] },
  { inv: '903', who: 'Vasant Logistics', gstin: '29AC•••••1Z2', twoB: '₹54,000', books: '—', tag: ['Not booked', 'red'] },
  { inv: '6031', who: 'Konkan Traders', gstin: '27AL•••••1Z2', twoB: '—', books: '₹2,14,600', tag: ['Supplier not filed', 'red'] },
  { inv: '745', who: 'Sahyadri Hospitality', gstin: '27AA•••••1Z4', twoB: '₹3,274', books: '₹3,274', tag: ['Matched', 'green'] },
];

const vendors = [
  { name: 'Pinecrest Maintenance', dot: 'red', tags: [['Overdue', 'red'], ['Requests ignored', 'amber'], ['Books ≠ bank', 'red']], bills: '12', out: '£29,380', over: '£29,380' },
  { name: 'Meridian Foods', dot: 'red', tags: [['Overdue', 'red'], ['Books ≠ bank', 'red']], bills: '137', out: '£28,820', over: '£27,930' },
  { name: 'Halden Logistics', dot: 'amber', tags: [['Overdue', 'red'], ['Requests ignored', 'amber']], bills: '32', out: '£7,500', over: '£5,440' },
];
---

<div class="stage" data-demo data-meta={JSON.stringify(meta.map(({ title, sub }) => ({ title, sub })))}>
  <Image src={heroBg} alt="" widths={[800, 1280, 1920]} sizes="100vw" class="bg" loading="eager" fetchpriority="high" />
  {
    hasVideo && (
      <video class="bg bg-video" muted loop playsinline preload="auto" poster={poster.src} aria-hidden="true" tabindex="-1">
        <source src="/hero/hero-loop.mp4" type="video/mp4" />
      </video>
    )
  }

  <div class="frame">
    <p class="sr-only">
      Product preview with demo data: the CFO cockpit, cash flow, payments received, bills, vendor reconciliation, GST reconciliation and approval board.
    </p>
    <div class="app" aria-hidden="true">
      <div class="app-in">
        <aside class="side">
          <p class="brand"><img src="/logo-green.png" alt="" width="14" height="17" />Radlabs</p>
          <p class="grp">Cashflow</p>
          <span class="nav on" data-nav="0"><Icon name="chart" size={16} />CFO cockpit</span>
          <span class="nav" data-nav="1"><Icon name="mail" size={16} />Cash flow</span>
          <p class="grp">Finances</p>
          <span class="nav" data-nav="2"><Icon name="cash" size={16} />Payments received</span>
          <span class="nav" data-nav="3"><Icon name="file" size={16} />Bills</span>
          <p class="grp">Reconciliation</p>
          <span class="nav" data-nav="4"><Icon name="scale" size={16} />Vendors</span>
          <span class="nav" data-nav="5"><Icon name="receipt" size={16} />GST</span>
          <p class="grp">Approvals</p>
          <span class="nav" data-nav="6"><Icon name="users" size={16} />Approval board</span>
          <p class="me"><span class="avatar">SK</span><span><strong>Sarah K.</strong><small>Finance Director</small></span></p>
        </aside>

        <div class="main">
          <header class="top">
            <div>
              <p class="title" data-title>{meta[0].title}</p>
              <p class="sub" data-sub>{meta[0].sub}</p>
            </div>
            <span class="refresh"><Icon name="refresh" size={15} /><span>Refresh from Xero</span></span>
          </header>

          <div class="screens">
            {/* CFO cockpit */}
            <section class="screen on">
              <div class="kpis">
                <p class="kpi"><span class="lbl">Cash to collect</span><span class="num">£1.42m</span><span class="hint">141 invoices outstanding</span></p>
                <p class="kpi"><span class="lbl">Bills due this week</span><span class="num">£318k</span><span class="hint">9 awaiting approval</span></p>
                <p class="kpi"><span class="lbl">Held before payment</span><span class="num red" data-count="21850" data-pre="£">£21,850</span><span class="hint">5 duplicates and already-paid</span></p>
                <p class="kpi"><span class="lbl">Books ≠ bank</span><span class="num amber" data-count="96200" data-pre="£">£96,200</span><span class="hint">58 payments to fix</span></p>
              </div>
              <div class="moves">
                <p class="move green"><span class="lbl">Collectable now</span><span class="num" data-count="148200" data-pre="£">£148,200</span><span class="hint">proven overdue, ready to chase</span></p>
                <p class="move red"><span class="lbl">At risk</span><span class="num" data-count="264900" data-pre="£">£264,900</span><span class="hint">90+ days and disputed</span></p>
                <p class="move blue"><span class="lbl">Decisions waiting</span><span class="num" data-count="31">31</span><span class="hint">holds, approvals, disputes</span></p>
              </div>
              <p class="lbl aging-lbl">Receivables by age</p>
              <div class="aging">
                <span style="flex:45;background:#cfd6de"></span><span style="flex:15;background:#4cbf86"></span><span style="flex:13;background:#f2c14e"></span><span style="flex:11;background:#ef8a3c"></span><span style="flex:16;background:#e2504a"></span>
              </div>
              <p class="legend">
                <span><i style="background:#cfd6de"></i>Not due <b>£640k</b></span>
                <span><i style="background:#4cbf86"></i>0–30d <b>£221k</b></span>
                <span><i style="background:#f2c14e"></i>30–60d <b>£187k</b></span>
                <span><i style="background:#ef8a3c"></i>60–90d <b>£142k</b></span>
                <span><i style="background:#e2504a"></i>90+ d <b>£230k</b></span>
              </p>
              <p class="overnight">
                <b>Overnight</b>
                <span><b>2,640</b> finance threads read</span>
                <span><b>412</b> payments matched</span>
                <span><b class="red">55</b> disputes with pushback</span>
              </p>
            </section>

            {/* Cash flow */}
            <section class="screen">
              <p class="pills"><span>Group by</span><b>Amount</b><b class="on">State</b><b>Client</b><b>Aging</b><b>Risk</b></p>
              <div class="list">
                <p class="lrow lhead trail-row"><span>Invoice and next action</span><span class="c-client">Client</span><span class="r">Amount</span><span>Tags</span><span class="c-act">Activity</span><span class="c-btn">Action</span></p>
                <p class="lrow group"><span><strong>Needs a decision</strong> <i class="count">3</i></span><span class="r total">£56,550</span></p>
                {
                  trail.map((t, i) => (
                    <p class="lrow trail-row anim edge" style={`--i:${i}`}>
                      <span class="inv"><strong>{t.inv}</strong><small>→ {t.next}</small></span>
                      <span class="c-client">{t.client}</span>
                      <span class="r strong">{t.amt}</span>
                      <span><i class={`t t-${t.tag[1]}`}>{t.tag[0]}</i></span>
                      <span class="c-act muted-red">{t.act}</span>
                      <span class={`btn-mini c-btn b-${t.btn[1]}`}>{t.btn[0]}</span>
                    </p>
                  ))
                }
                <p class="lrow group"><span><strong>Ready to chase</strong> <i class="count">2</i></span><span class="r total">£24,600</span></p>
                {
                  ready.map((t, i) => (
                    <p class="lrow trail-row anim" style={`--i:${i + 3}`}>
                      <span class="inv"><strong>{t.inv}</strong><small>→ {t.next}</small></span>
                      <span class="c-client">{t.client}</span>
                      <span class="r strong">{t.amt}</span>
                      <span><i class={`t t-${t.tag[1]}`}>{t.tag[0]}</i></span>
                      <span class="c-act muted">{t.act}</span>
                      <span class={`btn-mini c-btn b-${t.btn[1]}`}>{t.btn[0]}</span>
                    </p>
                  ))
                }
              </div>
            </section>

            {/* Payments received */}
            <section class="screen">
              <div class="banner">
                <span class="bang">!</span>
                <span>
                  <strong>38 of 412 payments have a mode or account mismatch</strong>
                  <small>Payment mode is recorded as cash, but the money landed in a bank account. Fix it at source and the flag clears on the next refresh.</small>
                  <i class="ghost-btn">Show only mismatched</i>
                </span>
              </div>
              <div class="list">
                <p class="lrow lhead pay-row"><span>Date</span><span class="c-no">Payment</span><span>Customer</span><span class="r">Amount</span><span class="c-acct">Account</span><span>Mode</span></p>
                {
                  payments.map((p, i) => (
                    <p class:list={['lrow', 'pay-row', 'anim', { flagged: p.flag }]} style={`--i:${i}`}>
                      <span>{p.date}</span>
                      <span class="c-no">{p.no}</span>
                      <span class="strong">{p.who}</span>
                      <span class="r strong">{p.amt}</span>
                      <span class="c-acct muted">Current account ••0406</span>
                      <span>{p.flag ? <i class="t t-amber">{p.mode} ⚠</i> : <i class="t t-grey">{p.mode}</i>}</span>
                    </p>
                  ))
                }
              </div>
            </section>

            {/* Bills */}
            <section class="screen">
              <div class="kpis kpis-3">
                <p class="kpi"><span class="lbl">Due this week</span><span class="num">£318k</span><span class="hint">64 bills</span></p>
                <p class="kpi"><span class="lbl">Held before payment</span><span class="num red" data-count="21850" data-pre="£">£21,850</span><span class="hint">5 duplicates and already-paid</span></p>
                <p class="kpi"><span class="lbl">Awaiting approval</span><span class="num amber" data-count="9">9</span><span class="hint">stuck ones chased by email</span></p>
              </div>
              <p class="chips"><b>All</b><b class="on">● Due this week</b><b>Held</b><b>Needs approval</b></p>
              <div class="list">
                <p class="lrow lhead bill-row"><span>Supplier and bill</span><span class="c-due">Due</span><span class="r">Amount</span><span>Check</span><span>Status</span></p>
                {
                  bills.map((b, i) => (
                    <p class="lrow bill-row anim" style={`--i:${i}`}>
                      <span class="vend"><strong>{b.who}</strong><small>{b.no}</small></span>
                      <span class="c-due">{b.due}</span>
                      <span class="r strong">{b.amt}</span>
                      <span><i class={`t t-${b.check[1]}`}>{b.check[0]}</i></span>
                      <span><i class={`t t-${b.status[1]}`}>{b.status[0]}</i></span>
                    </p>
                  ))
                }
              </div>
            </section>

            {/* Vendor reconciliation */}
            <section class="screen">
              <div class="kpis kpis-3">
                <p class="kpi">
                  <span class="lbl">Payments bank-verified</span><span class="num" data-count="67" data-suf="%">67%</span>
                  <span class="meter"><i></i></span>
                </p>
                <p class="kpi"><span class="lbl">Unverified value</span><span class="num red" data-count="412800" data-pre="£">£412,800</span><span class="hint">awaiting bank confirmation</span></p>
                <p class="kpi"><span class="lbl">Clean vendors</span><span class="num green">125 / 579</span><span class="hint">no open exceptions</span></p>
              </div>
              <p class="chips"><b>All</b><b>Paid, no bill</b><b>Overdue + email</b><b class="on">● Books ≠ bank</b></p>
              <div class="list">
                <p class="lrow lhead vend-row"><span>Vendor</span><span class="r c-bills">Bills</span><span class="r">Outstanding</span><span class="r">Overdue</span></p>
                {
                  vendors.map((v, i) => (
                    <p class="lrow vend-row anim" style={`--i:${i}`}>
                      <span class="vend">
                        <strong><i class={`dot d-${v.dot}`} />{v.name}</strong>
                        <span class="tags">{v.tags.map(([t, c]) => <i class={`t t-${c}`}>{t}</i>)}</span>
                      </span>
                      <span class="r c-bills">{v.bills}</span>
                      <span class="r strong">{v.out}</span>
                      <span class="r muted-red">{v.over}</span>
                    </p>
                  ))
                }
              </div>
            </section>

            {/* GST reconciliation */}
            <section class="screen">
              <div class="kpis kpis-3">
                <p class="kpi"><span class="lbl">Matched</span><span class="num green" data-count="1512">1,512</span><span class="hint">invoice and amount agree</span></p>
                <p class="kpi"><span class="lbl">Amount mismatches</span><span class="num amber" data-count="71">71</span><span class="hint">each with the reason</span></p>
                <p class="kpi"><span class="lbl">Credit at risk</span><span class="num red">₹20.9L</span><span class="hint">174 bills not in GSTR-2B</span></p>
              </div>
              <p class="chips"><b>All</b><b class="on">● Needs action</b><b>Not in books</b><b>Not in 2B</b></p>
              <div class="list">
                <p class="lrow lhead gst-row"><span class="c-inv">Invoice</span><span>Supplier</span><span class="r">GSTR-2B</span><span class="r">Books</span><span>Why</span></p>
                {
                  gst.map((g, i) => (
                    <p class="lrow gst-row anim" style={`--i:${i}`}>
                      <span class="c-inv">{g.inv}</span>
                      <span class="vend"><strong>{g.who}</strong><small>{g.gstin}</small></span>
                      <span class="r strong">{g.twoB}</span>
                      <span class="r">{g.books}</span>
                      <span><i class={`t t-${g.tag[1]}`}>{g.tag[0]}</i></span>
                    </p>
                  ))
                }
              </div>
            </section>

            {/* Approval board */}
            <section class="screen" data-approvals>
              <div class="cards4">
                <p class="sc amber"><span>Pending approval</span><strong data-count="18" data-after="17">18</strong></p>
                <p class="sc green"><span>Approved</span><strong data-count="41" data-after="42">41</strong></p>
                <p class="sc blue"><span>Paid</span><strong data-count="36">36</strong></p>
                <p class="sc yellow"><span>Needs recheck</span><strong data-count="3">3</strong></p>
              </div>
              <div class="list">
                <p class="lrow lhead appr-row"><span>Counterparty</span><span class="r">Amount</span><span class="c-appr">Approval</span><span>Where</span></p>
                <p class="lrow appr-row anim" style="--i:0" data-flip>
                  <span class="vend"><strong>Pinecrest Maintenance</strong><small>Bristol North depot</small></span>
                  <span class="r strong">£7,343.66</span>
                  <span class="c-appr"><i class="t t-grey p-wait">Pending</i><i class="t t-green p-ok">Approved</i></span>
                  <span><i class="t t-blue p-wait">Waiting: 1st approver</i><i class="t t-green p-ok">Approved by Sarah K.</i></span>
                </p>
                <p class="lrow appr-row anim" style="--i:1">
                  <span class="vend"><strong>Halden Logistics</strong><small>Leeds depot</small></span>
                  <span class="r strong">£12,480.00</span>
                  <span class="c-appr"><i class="t t-grey">Pending</i></span>
                  <span><i class="t t-blue">Waiting: 2nd approver</i></span>
                </p>
                <p class="lrow appr-row anim" style="--i:2">
                  <span class="vend"><strong>Brightwater Catering</strong><small>Head office</small></span>
                  <span class="r strong">£1,265.50</span>
                  <span class="c-appr"><i class="t t-green">Approved</i></span>
                  <span><i class="t t-grey">Paid by finance</i></span>
                </p>
                <p class="lrow appr-row anim" style="--i:3">
                  <span class="vend"><strong>Copperleaf Interiors</strong><small>Head office</small></span>
                  <span class="r strong">£7,400.00</span>
                  <span class="c-appr"><i class="t t-red">On hold</i></span>
                  <span><i class="t t-red">Already paid on 12 Sep</i></span>
                </p>
              </div>
            </section>
          </div>
        </div>
      </div>

      <span class="cursor">
        <svg viewBox="0 0 24 24" width="22" height="22"><path d="M4 2.5l15 9.2-6.6 1.3 3.9 7.2-2.8 1.5-3.9-7.2L4.9 19z" fill="#fff" stroke="#101614" stroke-width="1.5" stroke-linejoin="round"></path></svg>
      </span>
    </div>

    <div class="tabs" role="group" aria-label="Choose a product screen">
      {meta.map((m, i) => <button type="button" class="tab" data-tab={i} aria-pressed={i === 0 ? 'true' : 'false'}>{m.tab}</button>)}
    </div>
  </div>

  <button type="button" class="pause" aria-label="Pause animation" data-pause>
    <svg class="i-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
    <svg class="i-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
  </button>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-demo]');
  if (root) {
    const meta: { title: string; sub: string }[] = JSON.parse(root.dataset.meta || '[]');
    const app = root.querySelector<HTMLElement>('.app')!;
    const side = root.querySelector<HTMLElement>('.side')!;
    const screens = [...root.querySelectorAll<HTMLElement>('.screen')];
    const navs = [...root.querySelectorAll<HTMLElement>('[data-nav]')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const title = root.querySelector<HTMLElement>('[data-title]')!;
    const sub = root.querySelector<HTMLElement>('[data-sub]')!;
    const cursor = root.querySelector<HTMLElement>('.cursor')!;
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const video = root.querySelector<HTMLVideoElement>('.bg-video');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fmt = new Intl.NumberFormat('en-GB');
    const HOLD = 4600;

    let current = 0;
    let timers: number[] = [];
    let hovering = false;
    let stopped = reduce;
    let inView = true;
    let pending = false;

    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
    const clear = () => {
      timers.forEach(clearTimeout);
      timers = [];
    };

    const setNumber = (el: HTMLElement, value: number) => {
      el.textContent = (el.dataset.pre || '') + fmt.format(value) + (el.dataset.suf || '');
    };

    const countUp = (scope: HTMLElement) =>
      scope.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const end = Number(el.dataset.count);
        if (reduce) return setNumber(el, end);
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min(1, (now - start) / 900);
          setNumber(el, Math.round(end * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });

    // On the approval board, the first request gets approved while you watch.
    const approve = (scope: HTMLElement) => {
      const row = scope.querySelector<HTMLElement>('[data-flip]');
      if (!row) return;
      row.classList.remove('flipped');
      later(() => {
        row.classList.add('flipped');
        scope.querySelectorAll<HTMLElement>('[data-after]').forEach((el) => {
          setNumber(el, Number(el.dataset.after));
          el.classList.remove('bump');
          void el.offsetWidth;
          el.classList.add('bump');
        });
      }, 1900);
    };

    const pointAt = (el: HTMLElement, animate = true) => {
      const a = app.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      cursor.classList.toggle('jump', !animate);
      cursor.style.transform = `translate(${r.left - a.left + Math.min(r.width * 0.42, 74)}px, ${r.top - a.top + r.height * 0.5}px)`;
    };

    const show = (i: number) => {
      clear();
      pending = false;
      current = i;
      screens.forEach((s) => s.classList.remove('on'));
      void app.offsetWidth; // restart each screen's entrance animations
      screens[i].classList.add('on');
      navs.forEach((n, k) => n.classList.toggle('on', k === i));
      tabs.forEach((t, k) => t.setAttribute('aria-pressed', String(k === i)));
      title.textContent = meta[i].title;
      sub.textContent = meta[i].sub;
      if (!reduce && getComputedStyle(side).display !== 'none') pointAt(navs[i]);
      countUp(screens[i]);
      if (screens[i].hasAttribute('data-approvals') && !reduce) approve(screens[i]);
      later(advance, HOLD);
    };

    const advance = () => {
      if (stopped || hovering || !inView) {
        pending = true;
        return;
      }
      const next = (current + 1) % screens.length;
      if (getComputedStyle(side).display === 'none') return show(next);
      pointAt(navs[next]);
      later(() => {
        cursor.classList.add('click');
        later(() => {
          cursor.classList.remove('click');
          show(next);
        }, 220);
      }, 900);
    };

    const resume = () => {
      if (pending && !stopped && !hovering && inView) advance();
    };

    app.addEventListener('pointerenter', () => (hovering = true));
    app.addEventListener('pointerleave', () => {
      hovering = false;
      resume();
    });

    navs.forEach((n, k) => n.addEventListener('click', () => show(k)));
    tabs.forEach((t, k) => t.addEventListener('click', () => show(k)));

    const setStopped = (value: boolean) => {
      stopped = value;
      root.classList.toggle('is-paused', value);
      pauseBtn.setAttribute('aria-label', value ? 'Play animation' : 'Pause animation');
      if (video) value ? video.pause() : video.play().catch(() => {});
      if (!value) resume();
    };
    pauseBtn.addEventListener('click', () => setStopped(!stopped));

    if (video) {
      // Slower than generated for a calmer drift; the clip's first and last frames match, so it loops seamlessly.
      video.defaultPlaybackRate = video.playbackRate = 0.7;
      video.addEventListener('playing', () => video.classList.add('ready'));
      if (!reduce) video.play().catch(() => {});
    }

    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (video && !stopped) inView ? video.play().catch(() => {}) : video.pause();
        if (inView) resume();
      },
      { threshold: 0.15 },
    ).observe(root);

    if (reduce) {
      setStopped(true);
      show(0);
      clear();
    } else {
      requestAnimationFrame(() => pointAt(navs[0], false));
      show(0);
    }
  }
</script>

