---
// Hero visual: an invoice is read from the inbox, matched, approved, then held because it was already paid.
// Built in HTML so it stays sharp and can animate. Sizes use container units, so it scales as one piece.
import Icon from './Icon.astro';

const lines = [
  ['Boiler service visits', '12', '£185.00', '£2,220.00'],
  ['Emergency call-outs', '6', '£240.50', '£1,443.00'],
  ['Parts and materials', '40', '£38.75', '£1,550.00'],
  ['Waste disposal', '1', '£906.72', '£906.72'],
];

const fields = [
  ['Invoice no.', 'PM-1190'],
  ['Vendor', 'Pinecrest'],
  ['Invoice date', '16/09/2026'],
  ['Purchase order', 'PO-44817'],
  ['Job number', 'J-558'],
  ['GL account', '6100: Repairs'],
];

const events = [
  { icon: 'check', tone: 'ok', title: 'Invoice read from finance inbox', who: 'AI extraction', when: '06:02 AM' },
  { icon: 'merge', tone: '', title: 'Matched to PO-44817 and job J-558', who: 'ApprovalMax and Reflex', when: '06:02 AM' },
  { icon: 'users', tone: '', title: 'Approval received from Sarah K.', who: 'Operations manager', when: '09:14 AM' },
  { icon: 'alert', tone: 'bad', title: 'Already paid on 12 Sep. Payment held.', who: 'Checked against Xero', when: '09:15 AM', more: true },
];
---

<div class="collage" role="img" aria-label="An invoice from Pinecrest Maintenance is read from the finance inbox, matched to its purchase order and job, approved, and then held because it was already paid on 12 September.">
  <div class="stage" aria-hidden="true">
    <span class="glow glow-a"></span>
    <span class="glow glow-b"></span>

    <div class="doc card">
      <span class="scan"></span>
      <div class="doc-top">
        <div>
          <p class="doc-title">Invoice</p>
          <p class="doc-vendor">Pinecrest Maintenance Ltd</p>
        </div>
        <p class="doc-no"><span>Invoice no.</span><strong>PM-1190</strong></p>
      </div>
      <dl class="doc-meta">
        <div><dt>Invoice date:</dt><dd>16/09/26</dd></div>
        <div><dt>PO number:</dt><dd>PO-44817</dd></div>
        <div><dt>Due date:</dt><dd>28/10/26</dd></div>
      </dl>
      <table class="doc-lines">
        <thead>
          <tr><th>Item</th><th>Qty</th><th>Rate</th><th>Amount</th></tr>
        </thead>
        <tbody>
          {lines.map(([item, q, r, a]) => <tr><td>{item}</td><td>{q}</td><td>{r}</td><td>{a}</td></tr>)}
        </tbody>
      </table>
      <div class="doc-totals">
        <p><span>Subtotal:</span><span>£6,119.72</span></p>
        <p><span>VAT (20%):</span><span>£1,223.94</span></p>
        <p class="grand">
          <span>Total due:</span>
          <span class="ring">
            £7,343.66
            <svg viewBox="0 0 140 52" preserveAspectRatio="none">
              <path pathLength="1" d="M10 30 C 8 10, 60 3, 104 7 C 136 10, 138 36, 112 45 C 80 54, 22 50, 9 36 C 4 30, 14 20, 30 16"></path>
            </svg>
          </span>
        </p>
      </div>
      <p class="note">Already paid on 12 Sep!</p>
    </div>

    <div class="details card">
      <p class="det-id">PM-1190</p>
      <p class="det-head"><strong>7,343.66</strong><small>GBP</small><span>Pinecrest</span></p>
      <dl>
        {
          fields.map(([k, v], n) => (
            <div style={`--n:${n}`}>
              <dt>{k}</dt>
              <dd><span class="sk"></span><span class="v">{v}</span></dd>
            </div>
          ))
        }
      </dl>
    </div>

    <ol class="timeline card">
      {
        events.map((e, n) => (
          <li class:list={['ev', { 'ev-alert': e.tone === 'bad' }]} style={`--n:${n}`}>
            <span class:list={['ev-icon', e.tone]}><Icon name={e.icon} size={16} /></span>
            <div>
              <p class="ev-title">{e.title}</p>
              {e.more && <p class="ev-more"><Icon name="chevron-down" size={12} /> Additional details</p>}
              <p class="ev-who">{e.who}</p>
              <p class="ev-when">{e.when}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <span class="chip chip-ai"><i></i>AI reading the inbox</span>
    <span class="chip chip-conf"><Icon name="check" size={13} /> 98% confidence</span>

    <span class="flare flare-1"></span>
    <span class="flare flare-2"></span>
    <span class="flare flare-3"></span>
  </div>
</div>

<style>
  .collage {
    position: relative;
    width: 100%;
    aspect-ratio: 1.1;
    container-type: inline-size;
  }

  .stage {
    position: absolute;
    inset: 0;
    font-size: 1.8cqw;
    line-height: 1.35;
    color: #234b3d;
  }

  .stage p,
  .stage dl,
  .stage dd {
    margin: 0;
    max-width: none;
  }

  /* Ambient light */
  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    pointer-events: none;
  }

  .glow-a {
    width: 70%;
    height: 60%;
    right: -6%;
    bottom: 2%;
    background: radial-gradient(circle, rgba(34, 181, 115, 0.32), transparent 65%);
    animation: drift 16s ease-in-out infinite alternate;
  }

  .glow-b {
    width: 50%;
    height: 45%;
    left: 4%;
    top: 6%;
    background: radial-gradient(circle, rgba(120, 214, 170, 0.28), transparent 65%);
    animation: drift 20s ease-in-out infinite alternate-reverse;
  }

  .card {
    position: absolute;
    background: #fff;
    border-radius: 1.4em;
    box-shadow:
      0 0.1em 0.3em rgba(15, 51, 38, 0.06),
      0 2.4em 4.5em -1.6em rgba(15, 51, 38, 0.28);
    animation:
      enter 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both,
      float 9s ease-in-out 1s infinite;
  }

  /* Invoice document */
  .doc {
    left: 37%;
    top: 1%;
    width: 62%;
    height: 94%;
    padding: 3.4em 3em 2.6em;
    border: 1px solid rgba(201, 219, 210, 0.7);
    overflow: hidden;
    background: linear-gradient(180deg, #fff 60%, #f6fbf8);
  }

  .scan {
    position: absolute;
    left: 0;
    right: 0;
    top: -20%;
    height: 22%;
    background: linear-gradient(180deg, transparent, rgba(34, 181, 115, 0.14) 80%, rgba(34, 181, 115, 0.35));
    border-bottom: 2px solid rgba(34, 181, 115, 0.7);
    box-shadow: 0 6px 18px -4px rgba(34, 181, 115, 0.45);
    animation: scan 6s ease-in-out 0.6s infinite;
    pointer-events: none;
  }

  .doc-top {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1em;
  }

  .doc-title {
    font-size: 3.4em;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
  }

  .doc-vendor {
    margin-top: 0.7em;
    font-size: 1.35em;
    font-weight: 600;
    color: var(--ink);
  }

  .doc-no {
    display: grid;
    text-align: right;
    font-size: 0.9em;
    color: var(--ink-soft);
  }

  .doc-no strong {
    font-size: 1.25em;
    color: var(--ink);
  }

  .doc-meta {
    display: grid;
    justify-content: end;
    gap: 0.2em;
    margin: 2.6em 0 1.6em;
    font-size: 0.95em;
  }

  .doc-meta div {
    display: grid;
    grid-template-columns: 7.5em 6em;
  }

  .doc-meta dt {
    font-weight: 600;
    color: var(--ink);
  }

  .doc-lines {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95em;
  }

  .doc-lines th {
    text-align: right;
    font-weight: 600;
    color: var(--ink);
    padding: 0.4em 0 0.9em;
  }

  .doc-lines td {
    text-align: right;
    padding: 0.75em 0;
    color: #3d5a4f;
  }

  .doc-lines th:first-child,
  .doc-lines td:first-child {
    text-align: left;
  }

  .doc-totals {
    margin: 1.6em 0 0 auto;
    width: 62%;
    padding: 1em 1.3em;
    border-radius: 0.9em;
    background: #eef7f2;
    display: grid;
    gap: 0.45em;
    font-size: 0.95em;
  }

  .doc-totals p {
    display: flex;
    justify-content: space-between;
    color: #3d5a4f;
  }

  .doc-totals span:first-child {
    font-weight: 600;
    color: var(--ink);
  }

  .grand {
    padding-top: 0.5em;
    border-top: 1px solid #d6e8de;
    align-items: center;
  }

  .ring {
    position: relative;
    font-size: 1.5em;
    font-weight: 700;
    color: var(--ink);
  }

  .ring svg {
    position: absolute;
    inset: -0.5em -0.55em -0.45em -0.6em;
    width: calc(100% + 1.15em);
    height: calc(100% + 0.95em);
    max-width: none;
    overflow: visible;
  }

  .ring path {
    fill: none;
    stroke: var(--audit);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 0.8s ease-in-out 3.3s both;
  }

  .note {
    position: absolute;
    right: 2.6em;
    bottom: 0.9em;
    font-family: var(--hand);
    font-weight: 700;
    color: var(--audit);
    font-size: 1.55em;
    transform: rotate(-3deg);
    animation: appear 0.4s ease 3.9s both;
  }

  /* Extracted details */
  .details {
    left: 0;
    top: 37%;
    width: 33%;
    padding: 1.8em 1.7em 1.5em;
    animation-delay: 0.15s, 1.6s;
  }

  .det-id {
    color: var(--ink-soft);
    font-size: 0.95em;
  }

  .det-head {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    margin: 0.2em 0 1.2em;
    font-size: 1.35em;
    color: var(--ink);
  }

  .det-head small {
    font-size: 0.6em;
    font-weight: 600;
  }

  .det-head span {
    margin-left: 0.3em;
    padding-left: 0.6em;
    border-left: 1px solid var(--line);
    font-weight: 600;
  }

  .details dl div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6em;
    padding: 0.75em 0;
    border-top: 1px solid #edf2ef;
    font-size: 0.95em;
  }

  .details dt {
    color: var(--ink-soft);
  }

  .details dd {
    position: relative;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
  }

  .sk {
    position: absolute;
    left: 0;
    top: 50%;
    width: 80%;
    height: 0.8em;
    margin-top: -0.4em;
    border-radius: 0.4em;
    background: linear-gradient(90deg, #e6efe9 0%, #f6faf8 50%, #e6efe9 100%);
    background-size: 200% 100%;
    animation:
      shimmer 1.1s linear infinite,
      gone 0.3s ease calc(0.7s + var(--n) * 0.28s) forwards;
  }

  .v {
    animation: appear 0.35s ease calc(0.75s + var(--n) * 0.28s) both;
  }

  /* Activity timeline */
  .timeline {
    left: 22%;
    top: 21%;
    width: 40%;
    list-style: none;
    margin: 0;
    padding: 0.9em;
    display: grid;
    gap: 0.75em;
    background: rgba(244, 248, 246, 0.94);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    animation-delay: 0.3s, 2s;
  }

  .ev {
    display: flex;
    gap: 0.8em;
    padding: 1.05em 1.1em;
    background: #fff;
    border-radius: 0.9em;
    border: 1px solid #edf2ef;
    animation: rise 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) calc(1s + var(--n) * 0.55s) both;
  }

  .ev-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.9em;
    height: 1.9em;
    border-radius: 50%;
    border: 1.5px solid #a9bdb4;
    color: #6f877d;
  }

  .ev-icon :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }

  .ev-icon.ok {
    border-color: var(--brand-bright);
    color: var(--brand);
    background: #e9f7ef;
  }

  .ev-icon.bad {
    border-color: #e9a297;
    color: var(--audit);
    background: #fdeeec;
  }

  .ev-title {
    font-weight: 600;
    color: var(--ink);
    font-size: 1.05em;
    line-height: 1.3;
  }

  .ev-who {
    margin-top: 0.55em;
    font-weight: 600;
    color: #2d4a40;
  }

  .ev-when {
    color: #8aa097;
    font-size: 0.9em;
  }

  .ev-more {
    display: flex;
    align-items: center;
    gap: 0.4em;
    margin: 0.6em -1.1em 0 -3.8em;
    padding: 0.6em 1.1em 0.6em 3.8em;
    background: #fdf3f1;
    color: var(--audit);
    font-weight: 600;
    font-size: 0.95em;
  }

  .ev-more :global(svg) {
    width: 1em;
    height: 1em;
  }

  .ev-alert {
    border-color: #f2c9c2;
    animation:
      rise 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) calc(1s + var(--n) * 0.55s) both,
      alarm 2.6s ease-in-out 3.4s infinite;
  }

  /* Floating chips */
  .chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.55em 1em;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 1em 2em -1em rgba(15, 51, 38, 0.35);
    font-weight: 600;
    font-size: 1em;
    color: var(--ink);
    white-space: nowrap;
    animation:
      enter 0.6s ease both,
      float 7s ease-in-out infinite;
  }

  .chip-ai {
    left: 41%;
    top: -3%;
    animation-delay: 0.5s, 1.2s;
  }

  .chip-ai i {
    width: 0.65em;
    height: 0.65em;
    border-radius: 50%;
    background: var(--brand-bright);
    box-shadow: 0 0 0 0 rgba(34, 181, 115, 0.6);
    animation: ping 1.6s ease-out infinite;
  }

  .chip-conf {
    left: 3%;
    top: 89%;
    color: var(--brand);
    animation-delay: 2.4s, 2.8s;
  }

  .chip-conf :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }

  /* Light flares, like light catching the edge of glass */
  .flare {
    position: absolute;
    width: 2.6em;
    height: 2.6em;
    margin: -1.3em 0 0 -1.3em;
    background: radial-gradient(circle, #fff 0%, rgba(255, 255, 255, 0.9) 12%, rgba(190, 240, 214, 0.5) 30%, transparent 62%);
    pointer-events: none;
    animation: twinkle 4.2s ease-in-out infinite;
  }

  .flare::before,
  .flare::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.95), transparent);
    transform: translate(-50%, -50%);
  }

  .flare::before {
    width: 9em;
    height: 0.12em;
  }

  .flare::after {
    width: 0.12em;
    height: 4em;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.95), transparent);
  }

  .flare-1 {
    left: 37%;
    top: 63%;
  }

  .flare-2 {
    left: 92%;
    top: 58%;
    animation-delay: 1.6s;
  }

  .flare-3 {
    left: 13%;
    top: 37.5%;
    animation-delay: 2.9s;
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -7px;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes scan {
    0% {
      top: -22%;
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    55% {
      top: 100%;
      opacity: 1;
    }
    60%,
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes gone {
    to {
      opacity: 0;
    }
  }

  @keyframes shimmer {
    to {
      background-position: -200% 0;
    }
  }

  @keyframes alarm {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(194, 65, 45, 0);
    }
    50% {
      box-shadow: 0 0 0 0.45em rgba(194, 65, 45, 0.12);
    }
  }

  @keyframes ping {
    0% {
      box-shadow: 0 0 0 0 rgba(34, 181, 115, 0.55);
    }
    100% {
      box-shadow: 0 0 0 0.8em rgba(34, 181, 115, 0);
    }
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.9;
      transform: scale(1) rotate(0deg);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.7) rotate(12deg);
    }
  }

  @keyframes drift {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(-6%, 5%);
    }
  }

  /* Narrow screens: drop the details card and let the other two fill the space */
  @container (max-width: 520px) {
    .stage {
      font-size: 2.3cqw;
    }
    .details,
    .chip-conf,
    .flare-3 {
      display: none;
    }
    .timeline {
      left: 0;
      top: 24%;
      width: 56%;
    }
    .doc {
      left: 30%;
      width: 70%;
    }
    .chip-ai {
      left: 32%;
    }
  }
</style>
