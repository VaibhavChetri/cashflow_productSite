---
// Manual vs Radlabs, side by side (the upstream repo's table layout, with this site's wording).
// Phones: the two columns sit under each row's label.
import Icon from './Icon.astro';
import { site } from '../data/site';

const rows = [
  ['Data gathering', 'Download statements and exports from every bank, gateway and inbox', 'Inbox, ledger, bank and gateway data pulled in automatically every day'],
  ['Invoice capture', 'Re-key each invoice from PDFs and email bodies', 'AI reads every email and attachment, with a confidence score on each field'],
  ['Matching', 'Tick and match line by line in spreadsheets', 'Rules match invoices to approvals, jobs, ledger and bank'],
  ['Exceptions', 'Found at month-end, if they are found at all', 'Flagged the same day, with the reason and the next step'],
  ['Payment status', 'Search old emails to work out who said what', 'Threads are read to show who promised, disputed or proved payment'],
  ['Posting', 'Manual journals and CSV imports', 'Nothing posts without a confirmed match'],
  ['Audit trail', 'Scattered across inboxes, spreadsheets and shared drives', 'Every match and decision logged, from email to ledger'],
  ['Month-end', 'Days of reconciliation before you can close', 'Start the close from a short exception list'],
];
---

<table class="cmp">
  <thead>
    <tr>
      <th scope="col" class="cmp-task">The task</th>
      <th scope="col" class="cmp-manual"><span class="badge badge--x"><Icon name="x" size={14} /></span>Done by hand</th>
      <th scope="col" class="cmp-ai"><span class="badge badge--ok"><Icon name="check" size={14} /></span>With {site.name}</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map(([label, manual, ai]) => (
        <tr>
          <th scope="row">{label}</th>
          <td class="m">
            <Icon name="x" size={16} />
            <span>{manual}</span>
          </td>
          <td class="a">
            <Icon name="check" size={16} />
            <span>{ai}</span>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .cmp {
    width: 100%;
    border-collapse: collapse;
    background: #fff;
    border: 1px solid var(--line-strong);
    font-size: 1.0625rem;
  }

  .cmp thead th {
    text-align: left;
    padding: 26px 28px;
    font-weight: 500;
    font-size: 1.2rem;
    border-bottom: 2px solid var(--line-strong);
  }

  .cmp thead .cmp-task {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-soft);
    letter-spacing: 0.02em;
    vertical-align: middle;
  }

  .cmp-manual {
    background: #f6ebea;
    color: var(--ink);
  }

  .cmp-ai {
    background: #e6f3ea;
    color: var(--brand);
  }

  .badge {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-right: 12px;
    border-radius: 50%;
    vertical-align: middle;
  }

  .badge--x {
    background: #f7d4d0;
    color: var(--audit);
  }

  .badge--ok {
    background: #c9ebd6;
    color: var(--brand);
  }

  .cmp tbody th {
    text-align: left;
    font-weight: 500;
    color: var(--ink);
    padding: 22px 28px;
    width: 18%;
    vertical-align: middle;
  }

  .cmp tbody td {
    position: relative;
    padding: 22px 28px 22px 54px;
    vertical-align: middle;
    width: 41%;
  }

  .cmp tbody tr + tr > * {
    border-top: 1px solid var(--line);
  }

  .cmp td :global(svg) {
    position: absolute;
    left: 28px;
    top: 50%;
    margin-top: -8px;
  }

  .cmp td.m {
    color: var(--ink-soft);
  }

  .cmp td.m :global(svg) {
    color: #a8b5af;
  }

  .cmp td.a {
    color: var(--ink);
  }

  .cmp td.a :global(svg) {
    color: var(--brand);
  }

  @media (max-width: 760px) {
    .cmp thead .cmp-task {
      display: none;
    }
    .cmp thead tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .cmp thead th {
      padding: 16px;
      font-size: 0.95rem;
    }
    .badge {
      display: grid;
      margin: 0 0 8px;
    }
    .cmp tbody tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .cmp tbody th {
      grid-column: 1 / -1;
      width: auto;
      padding: 18px 16px 4px;
    }
    .cmp tbody td {
      width: auto;
      font-size: 0.95rem;
      padding: 8px 16px 18px 40px;
    }
    .cmp td :global(svg) {
      left: 16px;
      top: 10px;
      margin-top: 0;
    }
    .cmp tbody tr + tr > td {
      border-top: 0;
    }
  }
</style>
