---
import { site } from '../data/site';
---

<section class="cta" aria-labelledby="cta-title">
  <div class="wrap cta-inner">
    <div class="cta-text">
      <h2 id="cta-title">Find out what your inbox is hiding</h2>
      <p class="lede">
        We're taking {site.foundingPlaces} founding customers. Each gets a leakage audit on their own inbox and books, a founding price agreed up
        front, and a direct line to the people building {site.name}.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/founding-programme#apply">Apply for a founding place</a>
        <a class="btn btn-quiet" href="/leakage-calculator">Estimate your leakage</a>
      </div>
    </div>
    <p class="places" aria-hidden="true">
      <span class="num">{site.foundingPlaces}</span>
      <svg viewBox="0 0 200 140" preserveAspectRatio="none">
        <path d="M24 78 C 18 30, 110 8, 160 30 C 196 46, 190 106, 130 122 C 80 134, 22 118, 16 84 C 12 64, 36 46, 64 40"></path>
      </svg>
      <span class="hand label">founding places</span>
    </p>
  </div>
</section>

<style>
  .cta {
    background:
      radial-gradient(700px 380px at 85% 20%, rgba(34, 181, 115, 0.28), transparent 65%),
      radial-gradient(600px 320px at 10% 100%, rgba(34, 181, 115, 0.16), transparent 60%),
      linear-gradient(160deg, #0f3326, var(--dark));
    color: #e8f0eb;
    padding-block: clamp(72px, 10vw, 128px);
  }

  .cta h2 {
    font-weight: 500;
  }

  .cta-inner {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .cta-inner {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .cta-text {
    display: grid;
    gap: 20px;
  }

  .cta h2 {
    color: #fff;
    max-width: 16ch;
  }

  .cta .lede {
    color: #c3d3ca;
  }

  .cta .btn-quiet {
    border-color: #e8f0eb;
    color: #e8f0eb;
  }

  .cta .btn-quiet:hover {
    background: #e8f0eb;
    color: var(--ink);
  }

  .cta :focus-visible {
    outline-color: #7fd1a1;
  }

  .places {
    position: relative;
    justify-self: center;
    width: min(280px, 70vw);
    aspect-ratio: 10 / 7;
    display: grid;
    place-items: center;
    max-width: none;
  }

  .num {
    font-size: clamp(5rem, 12vw, 8rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #fff;
    line-height: 1;
  }

  .places svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .places path {
    fill: none;
    stroke: #e8695b;
    stroke-width: 3;
    stroke-linecap: round;
  }

  .label {
    position: absolute;
    right: -6px;
    bottom: -14px;
    color: #f08b7e;
    font-size: 1.375rem;
    transform: rotate(-4deg);
  }
</style>
