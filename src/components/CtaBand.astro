---
import { site } from '../data/site';

const steps = ['Reads your inbox', 'Checks books and bank', 'Shows you the money'];
const finds = [
  { tag: 'Already paid', tone: 'red', what: 'Pinecrest PM-1190', value: '£7,343.66' },
  { tag: 'Says paid', tone: 'purple', what: 'Kestrel, not in the bank', value: '£9,400' },
  { tag: 'No bill', tone: 'amber', what: 'Payments with no bill', value: '15 of 52' },
];
const total = '£16,743.66'; // the two money findings above
---

<section class="cta" aria-labelledby="cta-title">
  <div class="wrap cta-inner">
    <div class="cta-text">
      <h2 id="cta-title">Find out what your inbox is hiding</h2>
      <div class="actions">
        <a class="btn btn-primary" href="/founding-programme#apply">Book a free leakage audit</a>
        <a class="btn btn-quiet" href="/product">See how it works</a>
      </div>
    </div>
    <!-- Output first: the audit's process lights up, the findings land, then the total gets circled. Demo data, same as the founding programme report. -->
    <div class="audit" data-anim role="figure" aria-label="Example leakage audit, using demo data">
      <div class="a-top">
        <p class="a-title">Your leakage audit</p>
        <span class="a-demo">Demo data</span>
      </div>
      <ol class="a-steps">
        {steps.map((t, i) => <li style={`--i:${i}`}><span>{i + 1}</span>{t}</li>)}
      </ol>
      <ul class="a-finds">
        {
          finds.map((f, i) => (
            <li style={`--i:${i}`}>
              <span class={`a-tag a-tag--${f.tone}`}>{f.tag}</span>
              <span class="a-what">{f.what}</span>
              <strong>{f.value}</strong>
            </li>
          ))
        }
      </ul>
      <div class="a-total">
        <span>Money caught</span>
        <strong class="ring">
          {total}
          <svg viewBox="0 0 200 70" preserveAspectRatio="none" aria-hidden="true">
            <path pathLength="1" d="M22 36 C 14 8, 150 -2, 190 16 C 206 26, 202 58, 150 66 C 90 74, 10 66, 4 42 C 0 26, 26 14, 60 12"></path>
          </svg>
        </strong>
      </div>
      <p class="hand a-note" aria-hidden="true">with the proof attached</p>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    background:
      radial-gradient(700px 380px at 85% 20%, rgba(34, 181, 115, 0.28), transparent 65%),
      radial-gradient(600px 320px at 10% 100%, rgba(34, 181, 115, 0.16), transparent 60%),
      linear-gradient(160deg, #0f3326, var(--dark));
    color: #e8f0eb;
    padding-block: clamp(72px, 10vw, 128px);
  }

  .cta h2 {
    font-weight: 500;
  }

  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--dots);
    -webkit-mask-image: radial-gradient(50% 80% at 85% 50%, #000 10%, transparent 70%);
    mask-image: radial-gradient(50% 80% at 85% 50%, #000 10%, transparent 70%);
    opacity: 0.6;
  }

  .cta-inner {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .cta-inner {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .cta-text {
    display: grid;
    gap: 20px;
  }

  .cta h2 {
    color: #fff;
    max-width: 16ch;
  }

  .cta .btn-quiet {
    border-color: #e8f0eb;
    color: #e8f0eb;
  }

  .cta .btn-quiet:hover {
    background: #e8f0eb;
    color: var(--ink);
  }

  .cta :focus-visible {
    outline-color: #7fd1a1;
  }

  /* Audit card: glass on the dark band. Timeline once in view: steps light, findings land, total gets circled. */
  .audit {
    position: relative;
    justify-self: center;
    width: min(440px, 100%);
    display: grid;
    gap: 16px;
    padding: 22px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(232, 240, 235, 0.14);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(6px);
  }

  .audit p {
    max-width: none;
    margin: 0;
  }

  .a-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .a-title {
    color: #fff;
    font-weight: 500;
  }

  .a-demo {
    padding: 2px 10px;
    border-radius: 999px;
    background: rgba(232, 240, 235, 0.1);
    color: #c3d3ca;
    font-size: 0.75rem;
  }

  .a-steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding: 0;
    margin: 0;
  }

  .a-steps li {
    display: grid;
    gap: 6px;
    padding: 10px;
    border-radius: 12px;
    background: rgba(232, 240, 235, 0.05);
    color: #c3d3ca;
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .a-steps span {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid rgba(232, 240, 235, 0.3);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .a-finds {
    list-style: none;
    display: grid;
    padding: 0;
    margin: 0;
    border-top: 1px solid rgba(232, 240, 235, 0.12);
  }

  .a-finds li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    padding-block: 10px;
    border-bottom: 1px solid rgba(232, 240, 235, 0.12);
    font-size: 0.875rem;
  }

  .a-what {
    color: #c3d3ca;
  }

  .a-finds strong {
    color: #fff;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .a-tag {
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 0.6875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .a-tag--red {
    background: rgba(232, 105, 91, 0.18);
    color: #f5a99f;
  }

  .a-tag--purple {
    background: rgba(160, 130, 230, 0.2);
    color: #cdb9f5;
  }

  .a-tag--amber {
    background: rgba(224, 160, 58, 0.2);
    color: #f0c77e;
  }

  .a-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 4px;
    color: #c3d3ca;
  }

  .ring {
    position: relative;
    padding: 4px 10px;
    color: #fff;
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .ring svg {
    position: absolute;
    top: -18px;
    left: -16px;
    width: calc(100% + 48px);
    height: calc(100% + 36px);
    max-width: none;
    overflow: visible;
  }

  .ring path {
    fill: none;
    stroke: #e8695b;
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .a-note {
    position: absolute;
    right: 18px;
    bottom: -30px;
    color: #f08b7e;
    font-size: 1.25rem;
    transform: rotate(-4deg);
  }

  /* With JavaScript, play the timeline when the card scrolls into view. */
  :global(.js) .audit .a-steps li {
    transition: background-color 0.3s ease, color 0.3s ease;
    transition-delay: calc(0.2s + var(--i) * 0.4s);
  }

  :global(.js) .audit .a-steps span {
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    transition-delay: calc(0.2s + var(--i) * 0.4s);
  }

  :global(.js) .audit.in .a-steps li {
    background: rgba(34, 181, 115, 0.16);
    color: #e8f0eb;
  }

  :global(.js) .audit.in .a-steps span {
    background: #22b573;
    border-color: #22b573;
    color: #0f3326;
  }

  :global(.js) .audit .a-finds li,
  :global(.js) .audit .a-total {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  :global(.js) .audit .a-finds li {
    transition-delay: calc(1.4s + var(--i) * 0.25s);
  }

  :global(.js) .audit .a-total {
    transition-delay: 2.3s;
  }

  :global(.js) .audit.in .a-finds li,
  :global(.js) .audit.in .a-total {
    opacity: 1;
    transform: none;
  }

  :global(.js) .audit .ring path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1s cubic-bezier(0.6, 0, 0.3, 1) 2.6s;
  }

  :global(.js) .audit.in .ring path {
    stroke-dashoffset: 0;
  }

  :global(.js) .audit .a-note {
    opacity: 0;
    transition: opacity 0.4s ease 3.5s;
  }

  :global(.js) .audit.in .a-note {
    opacity: 1;
  }

  @media (max-width: 480px) {
    .a-steps {
      grid-template-columns: 1fr;
    }
    .a-steps li {
      grid-template-columns: auto 1fr;
      align-items: center;
    }
  }
</style>
