---
// Ledge-style switcher: AP, AR and GST, each with its outcome and its own product screen.
// Without JavaScript every panel shows, stacked.
import Icon from './Icon.astro';
import GstRecon from './GstRecon.astro';
import ApprovalMatch from './ApprovalMatch.astro';
import TrailRows from './TrailRows.astro';

const roles = [
  {
    id: 'ap',
    tab: 'AP teams',
    title: 'Every number on an invoice has a source',
    points: ['The invoice amount is checked against the email before approval', 'Duplicates and already-paid invoices held before the run', 'Stuck approvals chased when the approver is away'],
    cta: 'See payables',
    layout: 'side',
    href: '/product#payables',
  },
  {
    id: 'ar',
    tab: 'AR and collections',
    title: 'Know who will pay, and who only says they have',
    points: ['Every thread with every client read and summarised', 'Each "we\'ve paid you" checked against the bank', 'A next action on every unpaid invoice'],
    cta: 'See receivables',
    layout: 'side',
    href: '/product#receivables',
  },
  {
    id: 'gst',
    tab: 'GST',
    title: 'Both GST returns, checked against your books',
    points: ['GSTR-2B: every supplier bill, so you claim all your credit', 'GSTR-1: every sales invoice, before you file', 'Every gap comes with the reason'],
    cta: 'See GST reconciliation',
    layout: 'wide',
    href: '/india',
  },
];
---

<div class="roles" data-tabs>
  <div class="role-bar" role="tablist" aria-label="Choose your role">
    {
      roles.map((r, i) => (
        <button class="role-tab" role="tab" id={`tab-${r.id}`} aria-controls={`panel-${r.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          {r.tab}
        </button>
      ))
    }
  </div>

  <div class="role-panels">
  {
    roles.map((r, i) => (
      <div class={`role-panel role-panel--${r.layout}`} role="tabpanel" id={`panel-${r.id}`} aria-labelledby={`tab-${r.id}`} data-on={i === 0 ? '' : undefined}>
        <div class="role-text">
          <h3>{r.title}</h3>
          <div class="role-more">
            <ul class="ticks">
              {r.points.map((p) => <li>{p}</li>)}
            </ul>
            <a class="btn btn-dark" href={r.href}>
              {r.cta} <Icon name="arrow" size={18} />
            </a>
          </div>
        </div>
        <div class="role-ui shot-frame">
          {r.id === 'gst' && (
            <div class="gst-views">
              <fieldset class="gst-switch">
                <legend class="sr-only">Choose a GST return</legend>
                <label><input class="sr-only" type="radio" name="gst-view" value="2b" checked /><strong>GSTR-2B</strong> what you bought</label>
                <label><input class="sr-only" type="radio" name="gst-view" value="1" /><strong>GSTR-1</strong> what you sold</label>
              </fieldset>
              <div class="gst-2b"><GstRecon /></div>
              <div class="gst-1"><GstRecon return="1" /></div>
            </div>
          )}
          {r.id === 'ap' && <ApprovalMatch />}
          {r.id === 'ar' && <TrailRows />}
        </div>
      </div>
    ))
  }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!.toggleAttribute('data-on', on);
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
        if (step) select(tabs[(i + step + tabs.length) % tabs.length], true);
        if (e.key === 'Home') select(tabs[0], true);
        if (e.key === 'End') select(tabs[tabs.length - 1], true);
      });
    });
  });
</script>

<style>
  .role-bar {
    display: none;
  }

  :global(.js) .role-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 6px;
    gap: 6px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .role-tab {
    font: inherit;
    font-weight: 500;
    font-size: 1rem;
    min-height: 52px;
    padding: 10px 14px;
    border: 0;
    border-radius: 13px;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .role-tab:hover {
    color: var(--ink);
    background: var(--bg-soft);
  }

  .role-tab[aria-selected='true'] {
    background: var(--ink);
    color: #fff;
  }

  .role-panel {
    display: grid;
    gap: clamp(28px, 4vw, 44px);
    align-content: start;
  }

  .role-panels {
    display: grid;
    gap: 72px;
  }

  .role-text {
    display: grid;
    gap: 22px;
  }

  /* Narrow screens sit beside the text; wide tables get the full width below a two-column intro. */
  @media (min-width: 980px) {
    .role-panel--side {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 56px;
      align-items: center;
    }
    .role-panel--wide .role-text {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: start;
    }
  }

  .role-text h3 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
    max-width: 18ch;
  }

  .role-more {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .role-ui {
    min-width: 0;
  }

  /* The cash flow table is wide; scale it (like the product page screens) so it fits beside the text without scrolling. */
  #panel-ar .role-ui :global(.ui) {
    zoom: 0.8;
  }

  /* GST: one return at a time. A hidden table's demo cursor stops on its own (it's off screen). Without :has both show. */
  .gst-views {
    display: grid;
  }

  .gst-switch {
    display: inline-flex;
    justify-self: start;
    gap: 4px;
    padding: 4px;
    /* lines up with the table's own padding (.ui in ui.css) */
    margin: clamp(16px, 2.4vw, 28px) clamp(16px, 2.4vw, 28px) 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-soft);
  }

  .gst-switch label {
    display: flex;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .gst-switch strong {
    font-weight: 600;
    color: var(--ink);
  }

  .gst-switch label:has(input:checked) {
    background: var(--ink);
    color: #c3d6cc;
  }

  .gst-switch label:has(input:checked) strong {
    color: #fff;
  }

  .gst-switch label:has(input:focus-visible) {
    outline: 2px solid var(--brand-bright);
    outline-offset: 2px;
  }

  .gst-views:has([value='1']:checked) .gst-2b,
  .gst-views:has([value='2b']:checked) .gst-1 {
    display: none;
  }

  /* With JavaScript only the chosen panel takes up room, so short panels don't leave a gap. */
  :global(.js) .role-panel:not([data-on]) {
    display: none;
  }

  :global(.js) .role-panel[data-on] .role-ui {
    animation: settle 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  :global(.js) .role-panel[data-on] .role-text {
    animation: settle 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) 0.05s backwards;
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (max-width: 640px) {
    .role-bar {
      grid-template-columns: 1fr;
    }
    .role-tab {
      min-height: 46px;
    }
  }
</style>
