---
// Nanonets-style agent log: one night of the engine's work, typed in line by line when it scrolls into view.
// Demo data, consistent with the cockpit (2,640 threads, 412 payments, 31 decisions).
interface Line {
  t: string;
  text: string;
  state: string;
  tone: 'ok' | 'warn' | 'bad';
}
interface Props {
  lines?: Line[];
  heading?: string;
  headingId?: string;
  lede?: string;
  caption?: string;
  final?: string;
}

const defaultLines: Line[] = [
  { t: '02:00', text: 'Read 2,640 finance emails and 318 attachments', state: 'Read', tone: 'ok' },
  { t: '02:14', text: 'Extracted 211 invoices, every field with a confidence score', state: 'Extracted', tone: 'ok' },
  { t: '02:31', text: '412 payments matched to Xero and the bank feed', state: 'Matched', tone: 'ok' },
  { t: '02:48', text: 'Pinecrest PM-1190, £7,343.66, was already paid on 12 Sep. Held before the payment run', state: 'Held', tone: 'bad' },
  { t: '03:05', text: 'Kestrel Hospitality says INV-0388 was paid on Friday. Nothing in the bank', state: 'Needs proof', tone: 'warn' },
  { t: '03:20', text: 'GSTR-2B checked: 1,512 invoices agree, 71 mismatches explained', state: 'Explained', tone: 'ok' },
  { t: '04:02', text: 'Halden Logistics is waiting on 3 missing POs. Reply drafted for your review', state: 'Drafted', tone: 'warn' },
];

const {
  lines = defaultLines,
  heading = 'By 6am, the checking is done.',
  headingId = 'night-title',
  lede = 'Every night the engine reads the inbox, checks each invoice and payment against the ledger and the bank, and leaves your team a short list. Here is one night, line by line.',
  caption = 'Overnight run, Tuesday',
  final = 'Morning brief ready. 31 decisions waiting on you.',
} = Astro.props;
---

<div class="night" data-anim>
  <div class="night-text">
    <h2 id={headingId}>{heading}</h2>
    <p class="lede">{lede}</p>
    <ul class="key" aria-label="What the states mean">
      <li><i class="ok"></i>Cleared on its own</li>
      <li><i class="warn"></i>Needs a person</li>
      <li><i class="bad"></i>Money stopped</li>
    </ul>
  </div>

  <figure class="log">
    <figcaption class="log-bar">
      <span class="log-title">{caption}</span>
      <span class="log-live"><i></i>Demo workspace</span>
    </figcaption>
    <ol>
      {
        lines.map((l, n) => (
          <li style={`--n:${n}`}>
            <time>{l.t}</time>
            <span class="what">{l.text}</span>
            <span class={`state ${l.tone}`}>{l.state}</span>
          </li>
        ))
      }
      <li class="now" style={`--n:${lines.length}`}>
        <time>06:00</time>
        <span class="what"><strong>{final}</strong></span>
        <span class="state you">Your turn</span>
      </li>
    </ol>
  </figure>
</div>

<style>
  .night {
    display: grid;
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }

  @media (min-width: 1000px) {
    .night {
      grid-template-columns: 0.75fr 1.25fr;
    }
  }

  .night-text {
    display: grid;
    gap: 22px;
    align-content: start;
  }

  .night h2 {
    color: #fff;
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    letter-spacing: -0.035em;
  }

  .night .lede {
    color: #b9cec3;
  }

  .key {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 0.9375rem;
    color: #b9cec3;
  }

  .key li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .key i,
  .log-live i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .ok {
    --c: #5fd39a;
  }
  .warn {
    --c: #f2c14e;
  }
  .bad {
    --c: #ff8a7a;
  }

  .key i {
    background: var(--c);
  }

  /* The log window */
  .log {
    margin: 0;
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.03));
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    overflow: hidden;
    min-width: 0;
  }

  .log-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 16px 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.9375rem;
    color: #e8f0eb;
  }

  .log-title {
    font-weight: 500;
  }

  .log-live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #9fb8ab;
    font-size: 0.875rem;
  }

  .log-live i {
    background: #5fd39a;
    box-shadow: 0 0 0 0 rgba(95, 211, 154, 0.6);
    animation: ping 2s ease-out infinite;
  }

  .log ol {
    list-style: none;
    padding: 8px 0;
  }

  .log li {
    display: grid;
    grid-template-columns: 3.4em 1fr auto;
    gap: 16px;
    align-items: baseline;
    padding: 13px 22px;
    font-size: 0.975rem;
    line-height: 1.45;
    color: #d6e4dc;
  }

  .log li + li {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .log time {
    color: #94b0a2;
    font-variant-numeric: tabular-nums;
  }

  .state {
    justify-self: end;
    white-space: nowrap;
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 999px;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 14%, transparent);
  }

  .log .now {
    background: rgba(95, 211, 154, 0.08);
    color: #fff;
  }

  .log .now strong {
    font-weight: 500;
  }

  .state.you {
    --c: #0b2a1f;
    color: #0b2a1f;
    background: #5fd39a;
  }

  @media (max-width: 640px) {
    .log li {
      grid-template-columns: 3em 1fr;
      gap: 6px 12px;
      padding: 12px 16px;
      font-size: 0.9rem;
    }
    .state {
      grid-column: 2;
      justify-self: start;
    }
  }

  /* One orchestrated moment: lines arrive in order, the state chip lands just after its line. */
  :global(.js) .night .log li {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--n) * 0.42s + 0.2s);
  }

  :global(.js) .night .log li .state {
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.3, 1.4, 0.5, 1);
    transition-delay: calc(var(--n) * 0.42s + 0.5s);
  }

  :global(.js) .night.in .log li,
  :global(.js) .night.in .log li .state {
    opacity: 1;
    transform: none;
  }

  @keyframes ping {
    70% {
      box-shadow: 0 0 0 8px rgba(95, 211, 154, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(95, 211, 154, 0);
    }
  }
</style>
