---
import Layout from '../layouts/Layout.astro';
import HeroVideo from '../components/HeroVideo.astro';
import Cockpit from '../components/Cockpit.astro';
import IntegrationHub from '../components/IntegrationHub.astro';
import ModuleCards from '../components/ModuleCards.astro';
import AgentLog from '../components/AgentLog.astro';
import ContextGraph from '../components/ContextGraph.astro';
import RoleTabs from '../components/RoleTabs.astro';
import AuditSteps from '../components/AuditSteps.astro';
import CompareToggle from '../components/CompareToggle.astro';
import LeadersSection from '../components/LeadersSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Layout description={`${site.name} reads every email in your finance inbox, reconciles invoices and payments against your ledger, approvals and bank, and gives finance leaders a single view of every finance operation.`}>
  <!-- Hero: Notion-style. Big centred headline with a rotating phrase, then the launch film with its synced chapters. -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-head">
      <h1 id="hero-title">
        <span class="h-line">Your books say one thing.</span>
        <span class="h-line">
          Your inbox knows
          <span class="pill-wrap">
          <span class="sr-only">the truth.</span>
          <span class="swap" aria-hidden="true" data-swap>
            <i class="swap-dot"></i>
            <span class="swap-words">
              <span data-on>the truth</span>
              <span>what’s been paid</span>
              <span>who really paid</span>
              <span>what you owe</span>
            </span>
          </span>
          </span>
        </span>
      </h1>
      <div class="actions">
        <a class="btn btn-primary" href="/founding-programme#apply">Book a free leakage audit</a>
        <a class="btn btn-quiet" href="/product">See the product</a>
      </div>
    </div>
    <div class="wrap hero-film">
      <HeroVideo />
    </div>
  </section>

  <!-- Overnight agent log: the one dark moment near the top -->
  <section class="section night-band" aria-labelledby="night-title">
    <div class="wrap">
      <AgentLog />
    </div>
  </section>

  <!-- Leaders: the cockpit, in Stampli-style bento panels -->
  <section class="section" aria-labelledby="cockpit-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="cockpit-title">A bird's-eye view of every finance operation</h2>
        <p class="lede">
          With the CFO cockpit, finance leaders see the whole picture at a glance: cash to collect, bills due, payments held, approvals stuck and
          books that don't match the bank. Then drill into any number.
        </p>
      </div>

      <div class="bento">
        <div class="panel panel--wide panel--lead">
          <div class="panel-text">
            <h3>The CFO cockpit</h3>
            <p>One screen for payables, receivables, reconciliation and compliance, refreshed before your first meeting.</p>
            <a class="panel-link" href="/product#receivables">See the cockpit <Icon name="arrow" size={16} /></a>
          </div>
          <div class="panel-ui panel-ui--cockpit">
            <div class="shot-frame"><div class="win-bar" aria-hidden="true"><i></i><i></i><i></i></div><Cockpit /></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Context graph: every flag shows its working -->
  <section class="section band" aria-labelledby="cg-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="cg-title">Every flag shows its working</h2>
        <p class="lede">One invoice, four systems. Point at any part of the story to see the evidence behind it.</p>
      </div>
      <ContextGraph />
    </div>
  </section>

  <!-- Manual vs AI‑powered reconciliation -->
  <section class="section" aria-labelledby="cmp-title">
    <div class="wrap">
      <div class="section-head center">
        <h2 id="cmp-title">The same month-end, two ways</h2>
        <p class="lede">Flip the switch to see what changes when the checking happens overnight.</p>
      </div>
      <CompareToggle />
    </div>
  </section>

  <!-- Integrations -->
  <section class="section band" aria-labelledby="int-title">
    <div class="wrap">
      <div class="section-head center int-head">
        <h2 id="int-title">Connects to your inbox, ledger, banks and approvals.</h2>
        <p class="lede">
          Pre-built connectors for the systems finance teams already run. New ones plug into the same core.
          <a href="/integrations">See all integrations</a>
        </p>
      </div>
      <IntegrationHub />
    </div>
  </section>

  <!-- Modules -->
  <section class="section" aria-labelledby="mods-title">
    <div class="wrap">
      <div class="mods-top">
        <p class="mods-label">What it covers</p>
        <a class="mods-link" href="/product">See the full product <Icon name="arrow" size={16} /></a>
      </div>
      <h2 id="mods-title" class="mods-title">The rest of your finance operations, automated.</h2>
      <ModuleCards />
    </div>
  </section>

  <!-- Role tabs: what changes for each seat -->
  <section class="section band" aria-labelledby="roles-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="roles-title">Built around the exceptions, not the busywork</h2>
        <p class="lede">Pick your seat. Each team gets only the items that need a person, with the evidence attached.</p>
      </div>
      <RoleTabs />
      <p class="demo-note">All product screens show demo data.</p>
    </div>
  </section>

  <!-- Finance leaders -->
  <section class="section band" aria-label="For finance leaders">
    <div class="wrap">
      <LeadersSection />
    </div>
  </section>

  <!-- Leakage audit, Razorpay-style self-playing steps -->
  <section class="section" aria-labelledby="journey-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="journey-title">From first call to findings in two weeks</h2>
        <p class="lede">The leakage audit runs on your own inbox and books, so the first thing you see is real money.</p>
      </div>
      <AuditSteps />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section band" aria-labelledby="faq-title">
    <div class="wrap faq-split">
      <div class="section-head faq-head">
        <h2 id="faq-title">Questions finance leaders ask first</h2>
        <p class="lede">Something else on your mind? <a href={`mailto:${site.email}`}>Email the team</a>.</p>
      </div>
      <div class="faq">
        <details>
          <summary>What if the AI misreads an invoice?</summary>
          <div><p>Every extraction has a confidence score, and uncertain ones go to a person. Even a correct read has to match your ledger, approvals and bank before anything is treated as settled.</p></div>
        </details>
        <details>
          <summary>Do we have to change our accounting software?</summary>
          <div><p>No. {site.name} works on top of the ledger, approval tool and inbox you already use. See the <a href="/integrations">integrations page</a> for what's available now.</p></div>
        </details>
        <details>
          <summary>Does it make payments?</summary>
          <div><p>No. It tells your team what to pay, what to hold and who to chase. Paying stays with your people and your bank.</p></div>
        </details>
        <details>
          <summary>How long does it take to get started?</summary>
          <div><p>Start with a leakage audit: we connect to your inbox and ledger and report what we find, in money. If you go ahead, setup builds on the same connections.</p></div>
        </details>
        <details>
          <summary>Who is behind it?</summary>
          <div><p>{site.legalName}, an AI product studio working in the UK and India, with a background in governance, risk and compliance. <a href="/company">More about us</a>.</p></div>
        </details>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<script>
  // Rotate the hero phrase every 2.6s; the pill eases to each phrase's width. Skipped for reduced motion.
  const swap = document.querySelector<HTMLElement>('[data-swap] .swap-words');
  if (swap && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = [...swap.children] as HTMLElement[];
    let i = 0;
    const fit = () => (swap.style.width = `${words[i].getBoundingClientRect().width}px`);
    fit();
    document.fonts?.ready.then(fit);
    window.addEventListener('resize', fit);
    setInterval(() => {
      const prev = words[i];
      i = (i + 1) % words.length;
      prev.removeAttribute('data-on');
      prev.setAttribute('data-out', '');
      // Reset the outgoing phrase below the window instantly, so it doesn't sweep back through it
      setTimeout(() => {
        prev.style.transition = 'none';
        prev.removeAttribute('data-out');
        void prev.offsetWidth;
        prev.style.transition = '';
      }, 550);
      words[i].setAttribute('data-on', '');
      fit();
    }, 2600);
  }
</script>

<style>
  /* Hero: light and centred, like Notion's, so the pastel film sits naturally on the page */
  .hero {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    padding-block: calc(var(--header-h) + clamp(36px, 5.5vw, 76px)) clamp(56px, 7vw, 96px);
    overflow-x: clip;
    background:
      radial-gradient(900px 420px at 50% 0%, rgba(34, 181, 115, 0.1), transparent 70%),
      linear-gradient(180deg, #fff, var(--bg));
  }

  .hero-head {
    display: grid;
    justify-items: center;
    gap: 26px;
    text-align: center;
  }

  .hero h1 {
    max-width: none;
    font-size: clamp(2.1rem, 5vw, 4.5rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .h-line {
    display: block;
  }

  /* Wide screens: the pill sits on the second line and the line re-centres as it resizes. Phones: its own line. */
  .pill-wrap {
    display: inline;
  }

  @media (max-width: 900px) {
    .pill-wrap {
      display: block;
    }
  }

  /* Notion-style rotating phrase: a tinted pill whose width eases to fit each phrase */
  .swap {
    display: inline-flex;
    align-items: center;
    gap: 0.22em;
    vertical-align: bottom;
    margin-left: 0.1em;
    padding: 0.02em 0.32em 0.08em 0.26em;
    border-radius: 0.36em;
    background: #e3f3ea;
    color: var(--brand-deep);
  }

  .swap-dot {
    flex: none;
    width: 0.22em;
    height: 0.22em;
    border-radius: 50%;
    background: var(--brand-bright);
  }

  .swap-words {
    display: grid;
    overflow: hidden;
    white-space: nowrap;
    transition: width 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* Phrases slide through the pill's clipped window rather than fading, so the text is always at full contrast */
  .swap-words > span {
    grid-area: 1 / 1;
    justify-self: start;
    transform: translateY(110%);
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .swap-words > span[data-on] {
    transform: none;
  }

  .swap-words > span[data-out] {
    transform: translateY(-110%);
  }

  .hero .actions {
    justify-content: center;
    margin-top: 14px;
  }

  .hero-film {
    margin-top: clamp(40px, 5vw, 64px);
  }

  /* Bento panels */
  .bento {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 900px) {
    .bento {
      grid-template-columns: repeat(3, 1fr);
    }
    .panel--wide {
      grid-column: 1 / -1;
    }
  }

  .bento .panel {
    display: grid;
    align-content: space-between;
    gap: 28px;
    padding: clamp(24px, 3.4vw, 44px);
  }

  .panel-text {
    display: grid;
    gap: 12px;
    align-content: start;
    justify-items: start;
  }

  .panel-text h3 {
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    letter-spacing: -0.02em;
  }

  .panel-text p {
    color: var(--ink-soft);
  }

  .panel-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    text-decoration: none;
  }

  @media (min-width: 900px) {
    .panel--wide {
      grid-template-columns: 0.32fr 0.68fr;
      align-items: start;
      padding-right: 0;
      padding-bottom: 0;
    }
    .panel--wide .panel-text {
      padding-top: 8px;
    }
    .panel-ui--cockpit {
      margin-bottom: -2px;
    }
    .panel-ui--cockpit .shot-frame {
      border-radius: 16px 0 0 0;
      border-right: 0;
      border-bottom: 0;
    }
  }

  /* Integrations */
  .int-head h2 {
    font-weight: 400;
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    max-width: 22ch;
  }

  .int-head .lede a {
    white-space: nowrap;
  }

  /* Modules */
  .mods-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .mods-label {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .mods-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .mods-link:hover {
    color: var(--brand);
  }

  .mods-title {
    margin: 18px 0 44px;
    font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 3.75rem);
    letter-spacing: -0.035em;
  }

  .demo-note {
    margin-top: 28px;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  /* FAQ: heading stays in view while the questions scroll */
  @media (min-width: 980px) {
    .faq-split {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 64px;
      align-items: start;
    }
    .faq-head {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }

</style>
