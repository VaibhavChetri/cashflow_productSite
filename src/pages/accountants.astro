---
import Layout from '../layouts/Layout.astro';
import ClientPortfolio from '../components/ClientPortfolio.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

// Timings come from this page and the founding programme page. CONFIRM: audit length and access model (same as founding-programme.astro).
const partnerSteps = [
  { time: 'Within two working days', title: 'Apply as a firm', body: 'Tell us about your practice. We reply to book the first call.' },
  { time: '20 minutes', title: 'A call about your practice', body: 'Which clients, ledgers and inboxes you work with, and which two or three clients could try it.' },
  { time: 'Two weeks', title: 'Leakage audits for selected clients', body: `${site.name} runs on each client's real data, and you review what it finds together with us.` },
  { time: 'About an hour a month', title: 'Shape the product', body: 'Honest feedback on what helps your team, and a say in what we build next.' },
];
// The reconciliation sheet in the hero. Demo data, using the house names.
const sheetLetters = ['A', 'B', 'C', 'D', 'E', 'F'];
const sheetHead = ['Invoice', 'Supplier', 'Books', 'Bank', 'Diff', 'Status'];
const sheetRows = [
  { c: ['PM-1190', 'Pinecrest', '12,480.00', '12,480.00', '—', 'Matched'] },
  { c: ['PM-1191', 'Pinecrest', '3,215.50', '3,215.50', '—', 'Matched'] },
  { c: ['KS-0442', 'Kestrel', '8,940.00', '8,040.00', '900.00', 'Check'], bad: [3, 4, 5] },
  { c: ['HL-7781', 'Halden', '21,300.00', '21,300.00', '—', 'Matched'] },
  { c: ['KS-0443', 'Kestrel', '1,775.25', '—', '1,775.25', 'Not in bank'], bad: [3, 4, 5] },
  { c: ['PM-1192', 'Pinecrest', '6,420.00', '6,420.00', '—', 'Matched'] },
  { c: ['HL-7782', 'Halden', '9,115.80', '9,115.80', '—', 'Matched'] },
  { c: ['KS-0444', 'Kestrel', '14,260.00', '14,620.00', '-360.00', 'Check'], warn: [3, 4, 5] },
  { c: ['PM-1193', 'Pinecrest', '2,980.00', '2,980.00', '—', 'Matched'] },
  { c: ['HL-7783', 'Halden', '5,540.00', '—', '5,540.00', 'Not in bank'], bad: [3, 4, 5] },
  { c: ['PM-1194', 'Pinecrest', '18,075.40', '18,075.40', '—', 'Matched'] },
  { c: ['HL-7784', 'Halden', '11,902.65', '11,002.65', '900.00', 'Check'], warn: [3, 4, 5] },
];
---

<Layout title="For accounting and CA firms" description={`${site.name} for accounting and CA firms: your team reviews exceptions instead of re-keying invoices and matching statements by hand.`}>
  <section class="wrap page-head head-split">
    <div class="head-text">
      <p class="kicker">For accounting and CA firms</p>
      <h1>Spend your hours on judgment, not matching</h1>
      <p class="lede">
        {site.name} does the reading, keying and matching for your clients' books. Your team reviews the exceptions it finds and gives the advice
        clients actually pay for.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/founding-programme?type=firm#apply">Apply as a design partner</a>
      </div>
      <p class="head-live">Live today with <a href="/integrations">Xero, Zoho Books, ApprovalMax and Microsoft 365</a>.</p>
    </div>

    {/* The thing the headline is about: the reconciliation sheet, kept by hand, wrong in four places. */}
    <figure class="head-sheets">
      <div class="shot-frame">
        <div class="win-bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="xl-bar" aria-hidden="true">
          <span class="xl-ref">E7</span>
          <span class="xl-fx">=D7-C7</span>
        </div>
        <table class="xl">
          <caption class="sr-only">A bank reconciliation kept in a spreadsheet, with four rows that do not agree. Demo data.</caption>
          <thead>
            <tr class="xl-letters" aria-hidden="true">
              <th class="xl-corner"></th>
              {sheetLetters.map((l) => <th>{l}</th>)}
            </tr>
            <tr>
              <th class="xl-no" aria-hidden="true">1</th>
              {sheetHead.map((h, i) => <th class={i > 1 ? 'xl-num' : undefined}>{h}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              sheetRows.map((row, r) => (
                <tr>
                  <th class="xl-no" aria-hidden="true">{r + 2}</th>
                  {row.c.map((cell, i) => (
                    <td class:list={['xl-cell', i > 1 && 'xl-num', row.bad?.includes(i) && 'xl-bad', row.warn?.includes(i) && 'xl-warn']}>
                      {cell}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
        <div class="xl-tabs" aria-hidden="true">
          <span class="xl-tab xl-tab--on">Nov recon</span>
          <span class="xl-tab">Bank</span>
          <span class="xl-tab">Vendors</span>
          <span class="xl-tab">Oct recon</span>
        </div>
      </div>
      <figcaption>Demo data.</figcaption>
    </figure>
  </section>

  <section class="section band" aria-labelledby="change-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="change-title">What changes for your team</h2>
      </div>
      <ul class="ledger-list">
        <li><strong>Invoices and statements</strong><p>Read and keyed automatically from each client's inbox, instead of downloaded, opened and typed in.</p></li>
        <li><strong>Bank and payment matching</strong><p>Done every day, with the unmatched items listed and explained.</p></li>
        <li><strong>Client queries</strong><p>Answered from the email trail: who said what, when, and with what proof.</p></li>
        <li><strong>Month-end</strong><p>Starts from a short exception list rather than a full re-check.</p></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="see-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="see-title">Exceptions your clients will thank you for</h2>
        <p class="lede">
          Each flag explains itself in plain English, so you can pass it to a client without rewriting it. Source data is never changed behind
          anyone's back. Pick a client to see their morning.
        </p>
      </div>
      <ClientPortfolio />
      <p class="demo-note">All product screens show demo data.</p>
    </div>
  </section>

  <section class="section band" aria-labelledby="partner-title">
    <div class="wrap partner">
      <div class="section-head partner-head">
        <h2 id="partner-title">The design partner programme</h2>
        <p class="lede">
          We're working with a small number of firms to shape how {site.name} fits into practice life, starting with tools that let you see every
          client's exceptions in one place.
        </p>
        <a class="btn btn-primary" href="/founding-programme?type=firm#apply">Apply as a design partner</a>
      </div>

      <div class="partner-body">
        <ol class="timeline" data-anim>
          {
            partnerSteps.map((s, n) => (
              <li style={`--n:${n}`}>
                <p class="when">{s.time}</p>
                <div class="what">
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="deal">
          <div class="deal-side deal-get">
            <h3>What partner firms get</h3>
            <ul class="ticks">
              <li>Early access for your clients, with onboarding done with you</li>
              <li>Leakage audits for selected clients, run together</li>
              <li>A referral or reseller arrangement agreed with each firm</li>
              <li>A direct line to the product team and a say in the roadmap</li>
            </ul>
          </div>
          <div class="deal-side">
            <h3>What we ask</h3>
            <ul class="ticks">
              <li>Two or three clients willing to try it</li>
              <li>Honest feedback, about an hour a month</li>
              <li>Permission to share results, if you're happy with them</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap faq-split">
      <div class="section-head faq-head"><h2 id="faq-title">Questions from firms</h2></div>
      <div class="faq">
        <details>
          <summary>Does this replace our bookkeeping service?</summary>
          <div><p>No. It removes the keying and matching. The review, the judgment and the client relationship stay with you.</p></div>
        </details>
        <details>
          <summary>Who owns the client relationship?</summary>
          <div><p>You do. We work through you for every client you introduce.</p></div>
        </details>
        <details>
          <summary>Which accounting systems do your clients need?</summary>
          <div><p>Xero and Zoho Books today, with Tally and SAP next. See the <a href="/integrations">integrations page</a> for the full list.</p></div>
        </details>
        <details>
          <summary>Is it available for CA firms in India?</summary>
          <div><p>Yes, in early access, including GST reconciliation against GSTR-2B. <a href="/india">See {site.name} in India</a>.</p></div>
        </details>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .head-split {
    align-items: center;
  }

  @media (min-width: 920px) {
    .head-split {
      grid-template-columns: 1fr 1.05fr;
      gap: 56px;
    }
  }

  .head-text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .head-live {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  /* The sheet, and the two more behind it that also need checking. */
  .head-sheets {
    position: relative;
    isolation: isolate;
    margin: 0;
    display: grid;
    gap: 10px;
    justify-items: end;
  }

  .head-sheets::before,
  .head-sheets::after {
    content: '';
    position: absolute;
    inset: 0 0 32px;
    z-index: -1;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .head-sheets::before {
    transform: rotate(-3.4deg) translate(-22px, -16px);
  }

  .head-sheets::after {
    transform: rotate(2.6deg) translate(22px, -8px);
  }

  .head-sheets .shot-frame {
    position: relative;
    width: 100%;
  }

  .head-sheets figcaption {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  /* Name box and formula bar, the strip every one of these sheets opens with */
  .xl-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 12px;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    color: var(--ink-soft);
  }

  .xl-ref {
    min-width: 46px;
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg-soft);
  }

  .xl-fx {
    font-variant-numeric: tabular-nums;
  }

  .xl {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }

  .xl th,
  .xl td {
    border: 1px solid var(--line);
    padding: 6px 9px;
    text-align: left;
    white-space: nowrap;
    font-weight: 400;
    color: var(--text);
  }

  /* Column letters and row numbers: the grey furniture of the grid */
  .xl-letters th,
  .xl-no {
    background: var(--bg-soft);
    color: var(--ink-soft);
    text-align: center;
    font-size: 11px;
  }

  .xl-no {
    width: 26px;
  }

  .xl-corner {
    width: 26px;
    background: var(--tint);
  }

  .xl thead tr:last-child th {
    background: var(--tint);
    color: var(--ink);
    font-weight: 500;
  }

  .xl-num {
    text-align: right;
  }

  .xl-bad {
    background: rgba(194, 65, 45, 0.14);
    color: var(--audit);
  }

  .xl-warn {
    background: rgba(143, 84, 9, 0.16);
    color: var(--amber);
  }

  .xl-tabs {
    display: flex;
    gap: 4px;
    padding: 8px 12px;
    border-top: 1px solid var(--line);
    background: #fafcfb;
    font-size: 11px;
    color: var(--ink-soft);
  }

  .xl-tab {
    padding: 4px 10px;
    border-radius: 6px 6px 0 0;
  }

  .xl-tab--on {
    background: var(--surface);
    border: 1px solid var(--line);
    border-bottom-color: var(--surface);
    color: var(--ink);
  }

  .demo-note {
    margin-top: 24px;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  /* Design partner programme: heading and call to action stay put while the steps scroll past. */
  .partner {
    display: grid;
    gap: 8px;
  }

  .partner-head {
    justify-items: start;
  }

  @media (min-width: 980px) {
    .partner {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 64px;
      align-items: start;
    }
    .partner-head {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }

  .partner-body {
    display: grid;
    gap: 40px;
  }

  /* Glean-style steps: a time badge per step on a rail that fills as the section plays. */
  .timeline {
    --rail: 2px;
    list-style: none;
    position: relative;
    display: grid;
    gap: 14px;
  }

  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    left: 15px;
    top: 13px;
    bottom: 24px;
    width: var(--rail);
    border-radius: 2px;
    background: var(--line-strong);
  }

  .timeline::after {
    background: var(--brand-bright);
    transform-origin: top;
  }

  .timeline li {
    position: relative;
    display: grid;
    gap: 10px;
    padding-left: 48px;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    z-index: 1;
    left: 9px;
    top: 6px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--brand-bright);
    box-shadow: 0 0 0 5px var(--bg-soft);
  }

  .what {
    display: grid;
    gap: 6px;
    padding: 20px 22px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
  }

  .what p {
    color: var(--ink-soft);
  }

  .when {
    justify-self: start;
    padding: 3px 12px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
  }

  :global(.js) .timeline::after {
    transform: scaleY(0);
    transition: transform 2.4s linear 0.2s;
  }

  :global(.js) .timeline li::before {
    background: var(--surface);
    box-shadow: 0 0 0 5px var(--bg-soft), inset 0 0 0 2px var(--line-strong);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
    transition-delay: calc(var(--n) * 0.7s + 0.2s);
  }

  :global(.js) .timeline.in::after {
    transform: none;
  }

  :global(.js) .timeline.in li::before {
    background: var(--brand-bright);
    box-shadow: 0 0 0 5px var(--bg-soft);
  }

  /* What partner firms get, and what we ask, as one two-sided card */
  .deal {
    display: grid;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  @media (min-width: 700px) {
    .deal {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .deal-side {
    display: grid;
    gap: 18px;
    align-content: start;
    padding: clamp(24px, 3vw, 32px);
  }

  .deal-get {
    background: var(--dark);
    color: #c3d6cc;
  }

  .deal-get h3 {
    color: #fff;
  }

  .deal-get .ticks li::before {
    border-color: #5fd39a;
  }

  @media (min-width: 980px) {
    .faq-split {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 64px;
      align-items: start;
    }
    .faq-head {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }
</style>
