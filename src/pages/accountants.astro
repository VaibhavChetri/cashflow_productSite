---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ExceptionBanner from '../components/ExceptionBanner.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import practice from '../assets/img/practice.png';
---

<Layout title="For accounting and CA firms" description={`${site.name} for accounting and CA firms: your team reviews exceptions instead of re-keying invoices and matching statements by hand.`}>
  <section class="wrap page-head head-split">
    <div class="head-text">
      <p class="kicker">For accounting and CA firms</p>
      <h1>Spend your hours on judgment, not matching</h1>
      <p class="lede">
        {site.name} does the reading, keying and matching for your clients' books. Your team reviews the exceptions it finds and gives the advice
        clients actually pay for.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/founding-programme?type=firm#apply">Apply as a design partner</a>
      </div>
    </div>
    <Image src={practice} alt="Two accountants at a shared desk reviewing a spreadsheet on two monitors, with box files on the shelves behind them" widths={[480, 800, 1200]} sizes="(min-width: 920px) 45vw, 100vw" class="photo" loading="eager" />
  </section>

  <section class="section band" aria-labelledby="change-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="change-title">What changes for your team</h2>
      </div>
      <ul class="ledger-list">
        <li><strong>Invoices and statements</strong><p>Read and keyed automatically from each client's inbox, instead of downloaded, opened and typed in.</p></li>
        <li><strong>Bank and payment matching</strong><p>Done every day, with the unmatched items listed and explained.</p></li>
        <li><strong>Client queries</strong><p>Answered from the email trail: who said what, when, and with what proof.</p></li>
        <li><strong>Month-end</strong><p>Starts from a short exception list rather than a full re-check.</p></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="see-title">
    <div class="wrap split split--text-wide">
      <div class="section-head">
        <h2 id="see-title">Exceptions your clients will thank you for</h2>
        <p class="lede">
          Each flag explains itself in plain English, so you can pass it to a client without rewriting it. Source data is never changed behind
          anyone's back.
        </p>
      </div>
      <ExceptionBanner
        tone="info"
        title="15 of 52 payments have no bill attached"
        body="Usually advances, retainers or on-account payments. Check whether each one is intentional or a missing bill link."
        action="Show only payments with no bill"
      />
    </div>
  </section>

  <section class="section band" aria-labelledby="partner-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="partner-title">The design partner programme</h2>
        <p class="lede">
          We're working with a small number of firms to shape how {site.name} fits into practice life, starting with tools that let you see every
          client's exceptions in one place.
        </p>
      </div>
      <div class="two-col">
        <div>
          <h3>What partner firms get</h3>
          <ul class="ticks">
            <li>Early access for your clients, with onboarding done with you</li>
            <li>Leakage audits for selected clients, run together</li>
            <li>A referral or reseller arrangement agreed with each firm</li>
            <li>A direct line to the product team and a say in the roadmap</li>
          </ul>
        </div>
        <div>
          <h3>What we ask</h3>
          <ul class="ticks">
            <li>Two or three clients willing to try it</li>
            <li>Honest feedback, about an hour a month</li>
            <li>Permission to share results, if you're happy with them</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="section-head"><h2 id="faq-title">Questions from firms</h2></div>
      <div class="faq">
        <details>
          <summary>Does this replace our bookkeeping service?</summary>
          <div><p>No. It removes the keying and matching. The review, the judgment and the client relationship stay with you.</p></div>
        </details>
        <details>
          <summary>Who owns the client relationship?</summary>
          <div><p>You do. We work through you for every client you introduce.</p></div>
        </details>
        <details>
          <summary>Which accounting systems do your clients need?</summary>
          <div><p>Xero and Zoho Books today, with Tally and SAP next. See the <a href="/integrations">integrations page</a> for the full list.</p></div>
        </details>
        <details>
          <summary>Is it available for CA firms in India?</summary>
          <div><p>Yes, in early access, including GST reconciliation against GSTR-2B. <a href="/india">See {site.name} in India</a>.</p></div>
        </details>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .head-split {
    align-items: center;
  }

  @media (min-width: 920px) {
    .head-split {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }

  .head-text {
    display: grid;
    gap: 20px;
  }

  .two-col {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 860px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }

  .two-col h3 {
    margin-bottom: 18px;
  }
</style>
