---
import Layout from '../layouts/Layout.astro';
import AuditSteps from '../components/AuditSteps.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

// Netlify Forms works with no setup when formEndpoint is empty. Any other host needs formEndpoint set.
const action = site.formEndpoint || '/thanks';
---

<Layout title="Founding programme" description={`Apply for one of ${site.foundingPlaces} founding places: a leakage audit on your own inbox and books, a founding price, and a direct line to the team building ${site.name}.`}>
  <section class="section band" id="apply" aria-labelledby="apply-title">
    <div class="wrap apply">
      <div class="section-head apply-head">
        <h1 id="apply-title">Apply for a founding place</h1>
        <p class="lede">Tell us a little about your finance team. We'll reply within two working days to book the first call.</p>
        <p>Prefer email? Write to <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>

      <form class="form" name="founding" method="POST" action={action} data-netlify="true" netlify-honeypot="company_website">
        <input type="hidden" name="form-name" value="founding" />
        <p class="sr-only"><label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label></p>

        <fieldset class="field type">
          <legend>I'm applying as</legend>
          <div class="tiles">
            <label class="tile"><input type="radio" name="applicant_type" value="business" checked /> <span>A business with its own finance team</span></label>
            <label class="tile"><input type="radio" name="applicant_type" value="firm" /> <span>An accounting or CA firm</span></label>
          </div>
        </fieldset>

        <fieldset class="group">
          <legend><span aria-hidden="true">1</span> You and your company</legend>
          <div class="row">
            <div class="field">
              <label for="name">Your name</label>
              <input id="name" name="name" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="email">Work email</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>
          <div class="row">
            <div class="field">
              <label for="company">Company</label>
              <input id="company" name="company" autocomplete="organization" required />
            </div>
            <div class="field">
              <label for="role">Your role</label>
              <input id="role" name="role" autocomplete="organization-title" placeholder="e.g. Finance Director" />
            </div>
          </div>
        </fieldset>

        <fieldset class="group">
          <legend><span aria-hidden="true">2</span> Your finance set-up</legend>
          <div class="row row--3">
            <div class="field">
              <label for="country">Country</label>
              <select id="country" name="country">
                <option>United Kingdom</option>
                <option>India</option>
                <option>Other</option>
              </select>
            </div>
            <div class="field">
              <label for="ledger">Accounting system</label>
              <select id="ledger" name="ledger">
                <option>Xero</option>
                <option>Zoho Books</option>
                <option>Tally</option>
                <option>SAP</option>
                <option>QuickBooks</option>
                <option>Sage</option>
                <option>Other</option>
              </select>
            </div>
            <div class="field">
              <label for="volume">Supplier invoices per month</label>
              <select id="volume" name="volume">
                <option>Under 100</option>
                <option selected>100 to 500</option>
                <option>500 to 2,000</option>
                <option>More than 2,000</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="message">What's the biggest headache in your finance inbox? <span class="optional">(optional)</span></label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>
        </fieldset>

        <div class="form-foot">
          <div class="consent">
            <input id="consent" name="consent" type="checkbox" required />
            <label for="consent">I agree that {site.legalName} can use these details to contact me about the founding programme, as described in the <a href="/privacy">privacy notice</a>.</label>
          </div>
          <div class="submit-row">
            <button class="btn btn-primary btn-submit" type="submit">Apply for a founding place <Icon name="arrow" size={18} /></button>
            <p class="submit-note">We reply within two working days.</p>
          </div>
        </div>
      </form>
    </div>
  </section>

  <section class="section" aria-labelledby="audit-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="audit-title">How the audit works</h2>
        <p class="lede">From the first call to a report in money, on your own inbox and books.</p>
      </div>
      {/* CONFIRM: audit length and access model */}
      <AuditSteps />
    </div>
  </section>
</Layout>

<script>
  // Pre-select options when arriving from the accountants or India pages.
  const params = new URLSearchParams(location.search);
  if (params.get('type') === 'firm') {
    (document.querySelector('input[value="firm"]') as HTMLInputElement | null)?.click();
  }
  const country = params.get('country');
  if (country) {
    const select = document.getElementById('country') as HTMLSelectElement;
    select.value = country;
    if (country === 'India') (document.getElementById('ledger') as HTMLSelectElement).value = 'Zoho Books';
  }
</script>

<style>
  /* Application */
  .apply {
    display: grid;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 960px) {
    .apply {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 72px;
    }
    .apply-head {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }

  .form {
    display: grid;
    gap: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: clamp(22px, 4vw, 44px);
    box-shadow: var(--shadow-card);
  }

  .row {
    display: grid;
    gap: 18px;
  }

  @media (min-width: 640px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 640px) {
    .row--3 .field:last-child {
      grid-column: 1 / -1;
    }
  }

  .group {
    border: 0;
    margin: 0;
    padding: 28px 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 18px;
    min-width: 0;
  }

  .group legend {
    float: left;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    font-size: 1.125rem;
    color: var(--ink);
  }

  .group legend span {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--tint);
    color: var(--brand-deep);
    font-size: 0.875rem;
  }

  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: #a9c4b7;
  }

  .type {
    border: 0;
    padding: 0;
    margin: 0;
    gap: 10px;
    min-width: 0;
  }

  .tiles {
    display: grid;
    gap: 10px;
  }

  @media (min-width: 640px) {
    .tiles {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field .tile {
    display: flex;
    gap: 12px;
    align-items: center;
    min-height: 64px;
    padding: 14px 16px;
    border-radius: 16px;
    border: 1.5px solid var(--line-strong);
    background: var(--surface);
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.35;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .field .tile:hover {
    border-color: #a9c4b7;
  }

  .field .tile:has(:checked) {
    border-color: var(--brand);
    background: #f2faf5;
    box-shadow: 0 0 0 3px rgba(34, 181, 115, 0.14);
  }

  .tile:has(:focus-visible) {
    outline: 3px solid var(--brand-bright);
    outline-offset: 3px;
  }

  .field .tile input,
  .consent input {
    width: 20px;
    height: 20px;
    min-height: 0;
    flex: none;
    padding: 0;
    accent-color: var(--tick);
  }

  .tile input:focus {
    box-shadow: none;
  }

  .optional {
    font-weight: 400;
    color: var(--ink-soft);
  }

  .form-foot {
    display: grid;
    gap: 22px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .consent {
    display: flex;
    gap: 12px;
    align-items: start;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .consent input {
    margin-top: 3px;
  }

  .submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }

  .btn-submit {
    min-height: 56px;
    padding-inline: 28px;
    font-size: 1.0625rem;
  }

  .submit-note {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  @media (max-width: 639px) {
    .btn-submit {
      width: 100%;
    }
  }
</style>
