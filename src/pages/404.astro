---
import Layout from '../layouts/Layout.astro';

const pages = [
  { href: '/product', label: 'The product', text: 'How it reads the inbox and checks every invoice and payment.' },
  { href: '/founding-programme', label: 'Founding programme', text: 'Apply for a founding place and a leakage audit.' },
  { href: '/accountants', label: 'For accountants', text: "Your team reviews exceptions across every client's books." },
];
---

<Layout title="Page not found" description="This page doesn't exist.">
  <section class="wrap page-head missing">
    <p class="hand note">Not in the books.</p>
    <h1>This page doesn't exist</h1>
    <p class="lede">The link may be old, or the address mistyped. Start from the home page or see how the product works.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Go to the home page</a>
      <a class="btn btn-quiet" href="/product">See the product</a>
    </div>
  </section>

  <section class="section band" aria-labelledby="pages-title">
    <div class="wrap">
      <h2 id="pages-title" class="pages-title">Pages people look for</h2>
      <ul class="pages">
        {
          pages.map((pg) => (
            <li>
              <a href={pg.href}>
                <strong>{pg.label}</strong>
                <span>{pg.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .missing {
    min-height: 60vh;
    align-content: center;
  }

  /* The hand-written red is for light surfaces; on the dark band it needs the lighter coral to pass contrast. */
  .note {
    color: #f08b7e;
    font-size: 1.75rem;
    transform: rotate(-3deg);
    justify-self: start;
  }

  .pages-title {
    font-size: var(--step-3);
    margin-bottom: 28px;
  }

  .pages {
    list-style: none;
    display: grid;
    gap: 16px;
  }

  @media (min-width: 760px) {
    .pages {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .pages {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .pages a {
    display: grid;
    gap: 8px;
    height: 100%;
    padding: 22px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .pages a:hover {
    border-color: var(--brand-bright);
    box-shadow: var(--shadow-card);
  }

  .pages strong {
    color: var(--ink);
    font-size: 1.125rem;
  }

  .pages span {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }
</style>
