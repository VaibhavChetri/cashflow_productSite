---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

// Confidence table. Demo data, field reads only: the AI reads, rules do the matching.
// The threshold is the demo workspace's setting, not a product fact.
const threshold = 90;
// Each read carries where it came from (the highlighted bit is what the AI read), why it scored as it did, and what happens next.
type Part = string | { t: string; mark: 'ok' | 'ask' | 'missing' };
interface Read {
  doc: string;
  field: string;
  value: string;
  c: number;
  src: { kind: string; from: string; lines?: [string, Part][]; body?: Part[] };
  why: string;
  next: string;
}
const reads: Read[] = [
  {
    doc: 'Pinecrest PM-1190', field: 'Amount', value: '£7,343.66', c: 98,
    src: { kind: 'Invoice PDF', from: 'Pinecrest Maintenance', lines: [['Invoice no.', 'PM-1190'], ['Total due', { t: '£7,343.66', mark: 'ok' }]] },
    why: 'The total is printed clearly in a labelled box, so the AI is 98% sure it read it right.',
    next: "Moves on to be checked against your ledger, approvals and bank. That's the check that found this invoice was already paid.",
  },
  {
    doc: 'Pinecrest PM-1190', field: 'Due date', value: '28 Oct 2026', c: 97,
    src: { kind: 'Invoice PDF', from: 'Pinecrest Maintenance', lines: [['Invoice no.', 'PM-1190'], ['Due date', { t: '28 Oct 2026', mark: 'ok' }]] },
    why: 'A full date, next to the words "Due date". 97% sure.',
    next: 'Moves on, and is used to put the bill in the right payment run.',
  },
  {
    doc: 'Pinecrest PM-1190', field: 'PO number', value: 'PO-44817', c: 95,
    src: { kind: 'Invoice PDF', from: 'Pinecrest Maintenance', lines: [['Invoice no.', 'PM-1190'], ['PO number', { t: 'PO-44817', mark: 'ok' }]] },
    why: 'Labelled, and in the same format as your other purchase orders. 95% sure.',
    next: 'Moves on, and is matched to purchase order PO-44817 in your approval tool.',
  },
  {
    doc: 'Kestrel Hospitality email', field: 'Date they say they paid', value: '"Friday"', c: 64,
    src: { kind: 'Email', from: 'accounts@kestrel-hospitality.example', body: ['Hi, we paid INV-2026-0388 on ', { t: 'Friday', mark: 'ask' }, '. Thanks!'] },
    why: '"Friday" isn\'t a date. Which Friday? The email doesn\'t say, so the AI is only 64% sure.',
    next: 'Waits for a person. Someone confirms the date with Kestrel before Radlabs looks for the money in the bank.',
  },
  {
    doc: 'Halden Logistics invoice', field: 'PO number', value: 'Not found', c: 0,
    src: { kind: 'Invoice PDF', from: 'Halden Logistics', lines: [['Invoice no.', 'HL-7720'], ['PO number', { t: '', mark: 'missing' }]] },
    why: 'There is no PO number on this invoice, so there is nothing to read.',
    next: 'Waits for a person, who links it to the right purchase order before it moves on.',
  },
];

// Audit trail for one invoice. Same story and times as the homepage hero.
const trail = [
  { t: '06:02', who: 'AI', tag: 'blue', title: 'Read from the finance inbox', body: 'Supplier, amount, due date and PO number extracted, each with a confidence score.', src: 'Finance inbox' },
  { t: '06:02', who: 'Rules', tag: 'green', title: 'Matched to PO-44817 and job J-558', body: 'Four lines, £6,119.72 before VAT, agree with the order and the job.', src: 'Approval tool and job system' },
  { t: '09:14', who: 'Person', tag: 'purple', title: 'Approved by Sarah K.', body: 'Signed off by the operations manager in your approval tool.', src: 'Approval tool' },
  { t: '09:15', who: 'Rules', tag: 'green', bad: true, title: 'Held: already paid on 12 Sep', body: '£7,343.66 was paid to Pinecrest on 12 Sep and cleared at the bank.', src: 'Ledger and bank feed' },
];

// Standards we meet, each drawn in its familiar look. GDPR and the DPDP Act have no official logo, and ISO doesn't let companies
// use its own, so these are recreations: the EU-style star ring for GDPR, saffron and green for DPDP (no chakra or state emblem,
// which Indian law restricts), and a globe for ISO 27001. If you're certified, swap in your certification body's mark.
const certs = [
  { key: 'gdpr', name: 'GDPR', scope: 'EU and UK' },
  { key: 'dpdp', name: 'DPDP Act', scope: 'India' },
  { key: 'iso', name: 'ISO 27001', scope: 'Information security' },
];
// Twelve five-point stars on a ring, for the GDPR badge
const star = (cx: number, cy: number, r: number) =>
  'M' + Array.from({ length: 10 }, (_, k) => {
    const a = (Math.PI / 5) * k - Math.PI / 2;
    const d = k % 2 ? r * 0.4 : r;
    return `${(cx + d * Math.cos(a)).toFixed(2)},${(cy + d * Math.sin(a)).toFixed(2)}`;
  }).join('L') + 'Z';
const stars = Array.from({ length: 12 }, (_, i) => {
  const a = (Math.PI / 6) * i;
  return star(32 + 23 * Math.sin(a), 32 - 23 * Math.cos(a), 3.2);
}).join(' ');
---

<Layout title="AI and your data" description={`How ${site.name} uses AI, how your financial data is handled, and the standards we meet: GDPR, the DPDP Act and ISO 27001.`}>
  <section class="wrap page-head">
    <p class="kicker">AI and your data</p>
    <h1>AI reads. Rules reconcile. You decide.</h1>
    <p class="lede">
      Finance teams are right to be careful about AI near money. Here is exactly where {site.name} uses it, where it doesn't, and what happens to
      your data.
    </p>
  </section>

  <!-- Security and compliance: a lock that snaps shut on scroll, beside the standards we meet -->
  <section class="section band" aria-labelledby="comp-title">
    <div class="wrap duo">
      <div class="side side--never vault on-dark" data-anim>
        <p class="side-label"><span class="dot" aria-hidden="true"></span>Security and compliance</p>
        <h2 id="comp-title">Your financial data never leaves your control</h2>
        <p>Built to the data protection laws of the EU, UK and India, and to the ISO 27001 security standard.</p>
        <svg class="lock" viewBox="0 0 120 140" aria-hidden="true">
          <defs>
            <linearGradient id="lock-steel" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#8fa99c" /><stop offset="0.5" stop-color="#e3ece7" /><stop offset="1" stop-color="#8fa99c" /></linearGradient>
            <linearGradient id="lock-body" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f3f8f5" /><stop offset="1" stop-color="#bcd1c5" /></linearGradient>
          </defs>
          <circle class="halo" cx="60" cy="96" r="44" />
          <path class="shackle" d="M34 66V44a26 26 0 0 1 52 0v22" fill="none" stroke="url(#lock-steel)" stroke-width="12" stroke-linecap="round" />
          <rect x="16" y="60" width="88" height="72" rx="20" fill="url(#lock-body)" />
          <g class="keyhole"><circle cx="60" cy="91" r="9" /><rect x="56" y="95" width="8" height="17" rx="4" /></g>
        </svg>
        <a class="btn btn-quiet" href={`mailto:${site.email}?subject=Compliance%20reports`}>Ask for our compliance reports</a>
      </div>
      <div class="panel certs">
        <p class="side-label"><span class="dot" aria-hidden="true"></span>Compliance</p>
        {/* CONFIRM: compliance status and wording for each standard before launch */}
        <ul class="cert-list">
          {
            certs.map((c) => (
              <li class="cert">
                {c.key === 'gdpr' && (
                  <svg class="seal" viewBox="0 0 64 64" aria-hidden="true">
                    <circle cx="32" cy="32" r="31" fill="#003399" />
                    <path class="spin" d={stars} fill="#ffcc00" />
                    <path d="M27 31v-4a5 5 0 0 1 10 0v4" fill="none" stroke="#fff" stroke-width="2.4" />
                    <rect x="24.5" y="30" width="15" height="11" rx="2.5" fill="#fff" />
                    <circle cx="32" cy="34.6" r="1.7" fill="#003399" />
                    <rect x="31.2" y="35" width="1.6" height="3.6" rx="0.8" fill="#003399" />
                  </svg>
                )}
                {c.key === 'dpdp' && (
                  <svg class="seal" viewBox="0 0 64 64" aria-hidden="true">
                    <path d="M1 32a31 31 0 0 1 62 0z" fill="#ff9933" />
                    <path d="M63 32a31 31 0 0 1-62 0z" fill="#138808" />
                    <circle class="spin" cx="32" cy="32" r="27.5" fill="none" stroke="#fff" stroke-width="1" stroke-dasharray="1.5 2.5" />
                    <circle cx="32" cy="32" r="23" fill="#fff" stroke="#0b2f7a" stroke-width="1.5" />
                    <text x="32" y="33" text-anchor="middle" fill="#0b2f7a" font-size="10" font-weight="800">DPDP</text>
                    <text x="32" y="42" text-anchor="middle" fill="#0b2f7a" font-size="6.5" font-weight="600">Act 2023</text>
                  </svg>
                )}
                {c.key === 'iso' && (
                  <svg class="seal" viewBox="0 0 64 64" aria-hidden="true">
                    <circle cx="32" cy="32" r="31" fill="#fff" stroke="#0b4ea2" stroke-width="2" />
                    <g fill="none" stroke="#0b4ea2" stroke-width="1.4">
                      <circle cx="32" cy="23" r="11" />
                      <ellipse cx="32" cy="23" rx="5" ry="11" />
                      <path d="M21 23h22M23 17.5h18M23 28.5h18" />
                    </g>
                    <text x="32" y="47" text-anchor="middle" fill="#0b4ea2" font-size="11" font-weight="800">27001</text>
                  </svg>
                )}
                <p class="cert-name">
                  <strong>{c.name}</strong>
                  <span>{c.scope}</span>
                </p>
                <span class="cert-ok">Compliant</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Nanonets-style confidence threshold, with the source behind each read: pick a row to see where it came from and what happens next -->
  <section class="section" aria-labelledby="conf-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="conf-title">Confident, or it asks</h2>
        <p class="lede">The AI never guesses. When it isn't sure what it read, a person checks before anything happens.</p>
      </div>
      <ol class="rule">
        <li><span>1</span><p><strong>It reads</strong> each detail from the email or invoice: amount, date, PO number.</p></li>
        <li><span>2</span><p><strong>It scores</strong> how sure it is about each one, from 0 to 100%.</p></li>
        <li><span>3</span><p><strong>{threshold}% or more</strong> moves on to be checked. <strong>Below {threshold}%</strong>, a person looks first.</p></li>
      </ol>
      <figure class="shot">
        <div class="shot-frame">
          <div class="win-bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="ui conf" data-anim style={`--t:${threshold}%;--t-num:${threshold / 100}`}>
            <div class="conf-head">
              <p class="conf-title">Field reads <span class="conf-hint">Click a row to see where it came from</span></p>
              <p class="conf-key"><span class="line-key" aria-hidden="true"></span>Threshold in this demo workspace: {threshold}%</p>
            </div>
            <table>
              <thead>
                <tr>
                  <th scope="col">Document</th>
                  <th scope="col">Field</th>
                  <th scope="col">Read as</th>
                  <th scope="col" class="th-conf">Confidence <span class="th-line" aria-hidden="true">{threshold}%</span></th>
                  <th scope="col">Outcome</th>
                </tr>
              </thead>
              <tbody>
                {
                  reads.map((r, n) => {
                    const ok = r.c >= threshold;
                    const id = `read-${n}`;
                    return (
                      <tr style={`--n:${n}`} class={ok ? 'ok' : 'ask'}>
                        <td class="c-doc">
                          <input class="sr-only" type="radio" name="conf-read" id={id} value={n} checked={n === 0} aria-label={`${r.doc}, ${r.field}: show where it came from`} />
                          <label for={id}>{r.doc}</label>
                        </td>
                        <td class="c-field"><label for={id}>{r.field}</label></td>
                        <td class="c-val"><label for={id}><strong>{r.value}</strong></label></td>
                        <td class="c-conf">
                          <label for={id}>
                            <span class="track" aria-hidden="true"><i style={`--c:${r.c}%`}></i></span>
                            <span class="pct">{r.c === 0 ? 'No read' : `${r.c}%`}</span>
                          </label>
                        </td>
                        <td class="c-out">
                          <label for={id}><span class={`tag ${ok ? 'tag--green' : 'tag--amber'}`}>{ok ? 'Cleared on its own' : 'Asked a person'}</span></label>
                        </td>
                      </tr>
                    );
                  })
                }
              </tbody>
            </table>

            <div class="detail" aria-live="polite">
              {
                reads.map((r, n) => {
                  const ok = r.c >= threshold;
                  const part = (x: Part) =>
                    typeof x === 'string' ? x : <mark class={`hl hl--${x.mark}`}>{x.t || 'missing'}</mark>;
                  return (
                    <div class={`d-panel ${ok ? 'ok' : 'ask'}`} data-d={n}>
                      <div class="d-src">
                        <p class="d-label">Where it was read from</p>
                        <div class="doc">
                          <p class="doc-kind">{r.src.kind} · {r.src.from}</p>
                          {r.src.lines && (
                            <dl class="doc-lines">
                              {r.src.lines.map(([k, v]) => (
                                <div><dt>{k}</dt><dd>{part(v)}</dd></div>
                              ))}
                            </dl>
                          )}
                          {r.src.body && <p class="doc-body">{r.src.body.map(part)}</p>}
                        </div>
                      </div>
                      <div class="d-out">
                        <p class="d-label">Why, and what happens next</p>
                        <p class="d-why">{r.why}</p>
                        <p class="d-verdict">
                          <strong>{r.c === 0 ? 'No read' : `${r.c}%`}</strong>
                          <span>{r.c === 0 ? 'nothing to score' : `is ${ok ? 'above' : 'below'} the ${threshold}% line`}</span>
                          <span class="arrow" aria-hidden="true">→</span>
                          <span class={`tag ${ok ? 'tag--green' : 'tag--amber'}`}>{ok ? 'Cleared on its own' : 'Asked a person'}</span>
                        </p>
                        <p class="d-next">{r.next}</p>
                      </div>
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
        <figcaption>
          Demo data. The {threshold}% line is this demo workspace's setting. Below it, {site.name} never guesses or forces a match: the field waits
          for a person.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section band" aria-labelledby="data-title">
    <div class="wrap data-split">
      <div class="section-head data-head">
        <h2 id="data-title">Your data</h2>
        <p class="lede">Where it goes, who sees it, and what happens when you leave.</p>
      </div>
      {/* CONFIRM: model tier and terms, hosting regions, retention period, encryption details. Do not publish until each is true. */}
      <ul class="ledger-list">
        <li>
          <strong>The AI model</strong>
          <p>Extraction and reading use Google's Gemini models through Google Cloud, under enterprise terms that don't allow your data to be used to train Google's models.</p>
        </li>
        <li>
          <strong>Where it's stored</strong>
          <p>Your records live in our own database, not inside the AI model. We'll confirm the hosting region with you before you sign.</p>
        </li>
        <li>
          <strong>Who can see it</strong>
          <p>Access is limited to the people you authorise and the engineers supporting your account.</p>
        </li>
        <li>
          <strong>Keeping and deleting</strong>
          <p>We keep your data while you're a customer. When you leave, we delete it and confirm in writing.</p>
        </li>
        <li>
          <strong>Your rights</strong>
          <p>We handle personal data under UK GDPR and India's Digital Personal Data Protection Act, and sign a data processing agreement with every customer.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="audit-title">
    <div class="wrap split split--text-wide audit-split">
      <div>
        <div class="section-head flush">
          <h2 id="audit-title">A trail your auditors will like</h2>
          <p class="lede">
            Every invoice can be traced from the email it arrived in, through each approval, to the ledger entry and the bank line. Every decision on
            an exception records who made it and when.
          </p>
        </div>
      </div>

      <!-- Vertical audit trail for one invoice: each step lights as the line reaches it -->
      <figure class="shot">
        <div class="shot-frame">
          <div class="win-bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="ui trail" data-anim>
            <div class="trail-head">
              <div>
                <p class="trail-title">Pinecrest Maintenance, PM-1190</p>
                <p class="ui-sub">£7,343.66. Audit trail, Tuesday</p>
              </div>
              <span class="tag tag--red">Held</span>
            </div>
            <ol>
              {
                trail.map((s, n) => (
                  <li style={`--n:${n}`} class={s.bad ? 'bad' : undefined}>
                    <time>{s.t}</time>
                    <span class="node" aria-hidden="true"></span>
                    <div class="ev">
                      <p class="ev-top">
                        <span class={`tag tag--${s.tag}`}>{s.who}</span>
                        <strong>{s.title}</strong>
                      </p>
                      <p class="ev-body">{s.body}</p>
                      <p class="ev-src">Source: {s.src}</p>
                    </div>
                  </li>
                ))
              }
              <li class="you" style={`--n:${trail.length}`}>
                <time>Next</time>
                <span class="node" aria-hidden="true"></span>
                <div class="ev">
                  <p class="ev-top">
                    <span class="tag">You</span>
                    <strong>Release or keep on hold</strong>
                  </p>
                  <p class="ev-body">Whoever decides, and when, is added to this trail.</p>
                </div>
              </li>
            </ol>
          </div>
        </div>
        <figcaption>One invoice's trail, shown with demo data.</figcaption>
      </figure>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  /* Two-sided contrast */
  .duo {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 900px) {
    .duo {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }

  .side {
    display: grid;
    gap: 20px;
    align-content: start;
    padding: clamp(28px, 4vw, 52px);
    border-radius: 28px;
  }

  .side h2 {
    font-size: var(--step-3);
  }

  .side-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .side--never {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #c3d6cc;
    background:
      radial-gradient(600px 320px at 100% 0%, rgba(34, 181, 115, 0.2), transparent 65%),
      linear-gradient(170deg, #0f3326, var(--dark));
  }

  .side--never::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--dots);
    -webkit-mask-image: radial-gradient(70% 80% at 100% 100%, #000 5%, transparent 70%);
    mask-image: radial-gradient(70% 80% at 100% 100%, #000 5%, transparent 70%);
    opacity: 0.6;
  }

  .side--never h2 {
    color: #fff;
  }

  .side--never .side-label {
    color: #5fd39a;
  }

  .side--never .dot {
    background: #5fd39a;
  }

  /* The lock: the shackle drops shut and the keyhole lights when the card scrolls in */
  .lock {
    justify-self: center;
    width: clamp(110px, 14vw, 150px);
    margin: 8px 0;
    overflow: visible;
  }

  .keyhole {
    fill: var(--dark);
  }

  .halo {
    fill: rgba(95, 211, 154, 0.16);
    transform-origin: 60px 96px;
  }

  :global(.js) .vault .shackle {
    transform: translateY(-18px);
    transition: transform 0.55s cubic-bezier(0.3, 1.6, 0.5, 1) 0.4s;
  }

  :global(.js) .vault .keyhole {
    transition: fill 0.3s ease 0.9s;
  }

  :global(.js) .vault .halo {
    opacity: 0;
    transform: scale(0.6);
  }

  :global(.js) .vault.in .shackle {
    transform: none;
  }

  :global(.js) .vault.in .keyhole {
    fill: var(--brand-bright);
  }

  :global(.js) .vault.in .halo {
    animation: halo 1.1s ease-out 0.9s both;
  }

  @keyframes halo {
    0% {
      opacity: 0;
      transform: scale(0.6);
    }
    40% {
      opacity: 1;
    }
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
  }

  .vault .btn {
    justify-self: start;
  }

  /* Compliance list */
  /* Rows share the card's height, so it matches the lock card beside it */
  .certs {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 8px;
    padding: clamp(28px, 4vw, 52px);
    border-radius: 28px;
  }

  .certs .side-label {
    color: var(--brand);
  }

  .certs .dot {
    background: var(--brand-bright);
  }

  .cert-list {
    list-style: none;
    display: grid;
    grid-auto-rows: 1fr;
  }

  .cert {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  .cert:last-child {
    border-bottom: 0;
  }

  .seal {
    width: 64px;
    height: 64px;
    filter: drop-shadow(0 4px 10px rgba(15, 51, 38, 0.12));
  }

  .seal .spin {
    transform-origin: 32px 32px;
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* A slow turn of the star ring (GDPR) and dotted ring (DPDP) on hover */
  .cert:hover .seal .spin {
    transform: rotate(60deg);
  }

  .cert-name {
    display: grid;
    margin: 0;
  }

  .cert-name strong {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ink);
  }

  .cert-name span {
    color: var(--ink-soft);
  }

  .cert-ok {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--tint);
    color: var(--brand-deep);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .cert-ok::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-bright);
  }

  /* The rule, in three steps, above the table */
  .rule {
    list-style: none;
    display: grid;
    gap: 12px;
    margin: 0 0 clamp(24px, 3vw, 36px);
    padding: 0;
  }

  @media (min-width: 860px) {
    .rule {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .rule li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 12px;
    align-items: start;
    padding: 16px 18px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .rule p {
    margin: 0;
    max-width: none;
