---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';

// First paint uses the same defaults and formula as the script below, so the figures are right without JavaScript.
const fmt = (v: number) => new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP', maximumFractionDigits: 0 }).format(v);
const firstHours = (400 * 8) / 60;
const first = {
  leak: fmt(400 * 1200 * (0.5 / 100) * 12),
  hours: Math.round(firstHours).toLocaleString('en-GB'),
  time: fmt(firstHours * 30 * 12),
};
const shape = (text: string) => text.replace(/\d/g, '0');
const digits = (text: string) => [...text].map((ch) => ({ ch, d: /\d/.test(ch) }));
---

<Layout title="Leakage calculator" description="Estimate how much money and time your finance team loses each year to duplicate payments, errors and manual invoice handling.">
  <section class="wrap page-head">
    <h1>What is your finance inbox costing you?</h1>
    <p class="lede">
      A rough estimate from your own numbers. It's not a benchmark: change the error rate to whatever you believe is true for your business.
    </p>
  </section>

  <section class="section band calc-band" aria-labelledby="calc-title">
    <div class="wrap calc">
      <form class="inputs" id="calc" aria-labelledby="calc-title" onsubmit="return false">
        <h2 id="calc-title" class="sr-only">Your numbers</h2>
        <fieldset class="field currency">
          <legend>Currency</legend>
          <div class="seg">
            <label><input type="radio" name="cur" value="GBP" checked /> <span>£ GBP</span></label>
            <label><input type="radio" name="cur" value="INR" /> <span>₹ INR</span></label>
          </div>
        </fieldset>

        <div class="group">
          <p class="group-title" aria-hidden="true">Your invoices</p>
          <div class="field">
            <label for="inv">Supplier invoices per month</label>
            <input id="inv" name="inv" type="number" inputmode="numeric" min="0" step="10" value="400" />
          </div>
          <div class="field">
            <label for="avg">Average invoice value</label>
            <div class="affix"><span class="cur-sym" aria-hidden="true">£</span><input id="avg" name="avg" type="number" inputmode="decimal" min="0" step="50" value="1200" /></div>
          </div>
        </div>

        <div class="group">
          <p class="group-title" aria-hidden="true">Errors</p>
          <div class="field">
            <label for="rate">Share of invoices with a costly error (%)</label>
            <div class="affix affix--end"><input id="rate" name="rate" type="number" inputmode="decimal" min="0" max="20" step="0.1" value="0.5" aria-describedby="rate-help" /><span aria-hidden="true">%</span></div>
            <small id="rate-help">Duplicates, already-paid invoices and overpayments that go unnoticed. Start low; 0.5% is one invoice in 200.</small>
          </div>
        </div>

        <div class="group">
          <p class="group-title" aria-hidden="true">Time</p>
          <div class="field">
            <label for="mins">Minutes of handling per invoice</label>
            <div class="affix affix--end"><input id="mins" name="mins" type="number" inputmode="numeric" min="0" step="1" value="8" aria-describedby="mins-help" /><span aria-hidden="true">min</span></div>
            <small id="mins-help">Opening, keying, chasing approval and matching.</small>
          </div>
          <div class="field">
            <label for="cost">Cost of an hour of finance team time</label>
            <div class="affix"><span class="cur-sym" aria-hidden="true">£</span><input id="cost" name="cost" type="number" inputmode="decimal" min="0" step="1" value="30" /></div>
          </div>
        </div>
      </form>

      <div class="result on-dark" data-anim>
        <div class="r-top">
          <p class="r-kicker">Your estimate</p>
          <p class="r-chip">From your numbers, not a benchmark</p>
        </div>
        <p class="r-label">Money at risk each year</p>
        <p class="odo odo--big" id="out-leak" data-shape={shape(first.leak)} aria-hidden="true">
          {digits(first.leak).map(({ ch, d }) => (d ? <span class="col" style={`--d:${ch}`}><span>0123456789</span></span> : <span class="sym">{ch}</span>))}
        </p>
        <div class="r-pair">
          <div>
            <p class="r-label">Hours spent on handling each month</p>
            <p class="r-mid" aria-hidden="true">
              <span class="odo" id="out-hours" data-shape={shape(first.hours)}>
                {digits(first.hours).map(({ ch, d }) => (d ? <span class="col" style={`--d:${ch}`}><span>0123456789</span></span> : <span class="sym">{ch}</span>))}
              </span>
              <span class="unit">hours</span>
            </p>
          </div>
          <div>
            <p class="r-label">Cost of that time each year</p>
            <p class="r-mid" aria-hidden="true">
              <span class="odo" id="out-time" data-shape={shape(first.time)}>
                {digits(first.time).map(({ ch, d }) => (d ? <span class="col" style={`--d:${ch}`}><span>0123456789</span></span> : <span class="sym">{ch}</span>))}
              </span>
            </p>
          </div>
        </div>
        <p class="sr-only" aria-live="polite" id="out-sr">
          Money at risk each year: {first.leak}. Hours spent on handling each month: {first.hours} hours. Cost of that time each year: {first.time}.
        </p>
        <p class="r-note">
          How we work it out: invoices × average value × error rate × 12, and invoices × minutes ÷ 60 for hours. A leakage audit replaces these
          assumptions with what we actually find in your inbox and books.
        </p>
        <a class="btn btn-primary" href="/founding-programme#apply">Get the real number with a leakage audit</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<script>
  const form = document.getElementById('calc') as HTMLFormElement;
  const defaults = { GBP: { avg: 1200, cost: 30 }, INR: { avg: 50000, cost: 700 } } as const;
  const num = (id: string) => Math.max(0, Number((document.getElementById(id) as HTMLInputElement).value) || 0);
  const sr = document.getElementById('out-sr')!;
  let timer: number | undefined;

  function format(value: number, cur: 'GBP' | 'INR') {
    return new Intl.NumberFormat(cur === 'INR' ? 'en-IN' : 'en-GB', {
      style: 'currency',
      currency: cur,
      maximumFractionDigits: 0,
    }).format(value);
  }

  // Mysa-style odometer, the same approach as LeakSlider: rebuild only when the number's shape changes, otherwise roll each digit column.
  function roll(el: HTMLElement, text: string) {
    const shape = text.replace(/\d/g, '0');
    if (el.dataset.shape !== shape) {
      el.innerHTML = [...text]
        .map((ch) => (/\d/.test(ch) ? '<span class="col" style="--d:0"><span>0123456789</span></span>' : `<span class="sym">${ch}</span>`))
        .join('');
      el.getBoundingClientRect();
    }
    el.dataset.shape = shape;
    el.toggleAttribute('data-long', text.length > 10);
    const cols = el.querySelectorAll<HTMLElement>('.col');
    [...text.replace(/\D/g, '')].forEach((d, i) => cols[i]?.style.setProperty('--d', d));
  }

  function update() {
    const cur = (new FormData(form).get('cur') as 'GBP' | 'INR') ?? 'GBP';
    const inv = num('inv');
    const leak = inv * num('avg') * (num('rate') / 100) * 12;
    const hours = (inv * num('mins')) / 60;
    form.querySelectorAll('.cur-sym').forEach((el) => (el.textContent = cur === 'INR' ? '₹' : '£'));
    const out = { leak: format(leak, cur), hours: Math.round(hours).toLocaleString('en-GB'), time: format(hours * num('cost') * 12, cur) };
    roll(document.getElementById('out-leak')!, out.leak);
    roll(document.getElementById('out-hours')!, out.hours);
    roll(document.getElementById('out-time')!, out.time);
    // Screen readers hear one plain sentence once typing pauses, not every digit.
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      sr.textContent = `Money at risk each year: ${out.leak}. Hours spent on handling each month: ${out.hours} hours. Cost of that time each year: ${out.time}.`;
    }, 400);
  }

  form.addEventListener('input', update);
  form.querySelectorAll<HTMLInputElement>('input[name="cur"]').forEach((r) =>
    r.addEventListener('change', () => {
      const d = defaults[r.value as 'GBP' | 'INR'];
      (document.getElementById('avg') as HTMLInputElement).value = String(d.avg);
      (document.getElementById('cost') as HTMLInputElement).value = String(d.cost);
      update();
    }),
  );
  update();
</script>

<style>
  .calc {
    display: grid;
    gap: 32px;
    align-items: start;
  }

  @media (min-width: 960px) {
    .calc {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 48px;
    }
  }

  /* Inputs: one white card, grouped by what the number is about */
  .inputs {
    display: grid;
    gap: 26px;
    padding: clamp(22px, 3.4vw, 36px);
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
  }

  .group {
    display: grid;
    gap: 18px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .group-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--brand-deep);
  }

  .currency {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .currency legend {
    margin-bottom: 8px;
  }

  /* Segmented currency switch: real radios, styled as one pill */
  .seg {
    display: inline-grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
  }

  .seg label {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 108px;
    min-height: 42px;
    padding: 0 16px;
    border-radius: 999px;
    font-weight: 500;
    font-size: 1rem;
    color: var(--ink-soft);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .seg input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    opacity: 0;
    cursor: pointer;
  }

  .seg label:has(:checked) {
    background: var(--ink);
    color: #fff;
  }

  .seg label:has(:focus-visible) {
    outline: 3px solid var(--brand-bright);
    outline-offset: 2px;
  }

  /* Units sit inside the input, so the label can stay as it is */
  .affix {
    position: relative;
    display: flex;
    align-items: center;
  }

  .affix > span {
    position: absolute;
    left: 15px;
    color: var(--ink-soft);
    pointer-events: none;
  }

  .affix input {
    padding-left: 34px;
  }

  .affix--end > span {
    left: auto;
    right: 15px;
  }

  .affix--end input {
    padding-left: 14px;
    padding-right: 52px;
  }

  .field input:hover {
    border-color: #a9c4b7;
  }

  /* The result: a dark card with rolling figures, the hero of the page */
  .result {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: 10px;
    justify-items: start;
    padding: clamp(26px, 4vw, 48px);
    border-radius: 28px;
    color: #c3d6cc;
    background:
      radial-gradient(520px 320px at 100% 0%, rgba(34, 181, 115, 0.3), transparent 65%),
      linear-gradient(160deg, #0f3326, var(--dark));
    box-shadow: 0 40px 80px -40px rgba(11, 42, 31, 0.7);
  }

  .result::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--dots);
    -webkit-mask-image: radial-gradient(60% 60% at 100% 100%, #000 5%, transparent 70%);
    mask-image: radial-gradient(60% 60% at 100% 100%, #000 5%, transparent 70%);
    opacity: 0.6;
  }

  @media (min-width: 960px) {
    .result {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }

  .result p {
    margin: 0;
    max-width: none;
  }

  .r-top {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .result .r-kicker {
    color: #5fd39a;
    font-weight: 500;
  }

  .result .r-chip {
    font-size: 0.8125rem;
    padding: 3px 12px;
    border-radius: 999px;
    border: 1px solid rgba(195, 214, 204, 0.3);
    color: #c3d6cc;
  }

  .result .r-label {
    color: #c3d6cc;
    font-size: 0.9375rem;
  }

  .r-pair {
    width: 100%;
    display: grid;
    gap: 20px;
    margin-top: 22px;
  }

  @media (min-width: 520px) {
    .r-pair {
      grid-template-columns: 1fr 1fr;
    }
  }

  .r-pair > div {
    display: grid;
    gap: 6px;
  }

  .r-mid {
    display: flex;
    align-items: baseline;
    gap: 10px;
    color: #fff;
    font-size: clamp(1.8rem, 3.4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .unit {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    color: #c3d6cc;
  }

  /* Odometer: each digit is a 0–9 strip in a one-digit window, rolled to its value */
  .odo {
    display: inline-flex;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .odo--big {
    margin-top: 4px;
    padding-bottom: 14px;
    font-size: clamp(3.2rem, 8vw, 5.75rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    color: #ffb3a6;
    border-bottom: 5px double rgba(255, 179, 166, 0.55);
  }

  /* Very large figures step down a size rather than overflow the card */
  .odo--big[data-long] {
    font-size: clamp(2.2rem, 5.2vw, 4rem);
  }

  .r-mid .odo[data-long] {
    font-size: 0.78em;
  }

  .odo {
    flex-wrap: wrap;
  }

  .odo :global(.col) {
    display: inline-block;
    height: 1em;
    overflow: hidden;
  }

  .odo :global(.col > span) {
    display: block;
    width: 0.6em;
    text-align: center;
    word-break: break-all;
    line-height: 1;
    transform: translateY(calc(var(--d) * -1em));
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .odo :global(.sym) {
    white-space: pre;
  }

  /* First view: the digits roll up from zero, once, when the card scrolls in */
  :global(.js) .result:not(.in) .odo :global(.col > span) {
    transform: translateY(0);
  }

  .result .r-note {
    margin: 22px 0 12px;
    font-size: 0.9375rem;
    color: #c3d6cc;
  }

  @media (max-width: 519px) {
    .result .btn {
      width: 100%;
    }
  }
</style>
